{{ 'component-slideshow.css' | asset_url | stylesheet_tag }}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500&family=Great+Vibes&family=Inter:wght@400;500&display=swap');

  /* ---------- CUSTOM LUXURY DESIGN OVERRIDES ---------- */

  #shopify-section-{{ section.id }} .slideshow {
    height: {{ section.settings.height_mobile }}px !important;
    min-height: {{ section.settings.height_mobile }}px !important;
  }
  
  @media screen and (min-width: 768px) {
    #shopify-section-{{ section.id }} .slideshow {
      height: {{ section.settings.height_tablet }}px !important;
      min-height: {{ section.settings.height_tablet }}px !important;
    }
  }
  
  @media screen and (min-width: 990px) {
    #shopify-section-{{ section.id }} .slideshow {
      height: {{ section.settings.height_desktop }}px !important;
      min-height: {{ section.settings.height_desktop }}px !important;
    }
  }

  /* Force image to cover without gaps or stretching */
  #shopify-section-{{ section.id }} .banner__media {
    height: 100% !important;
    position: absolute !important;
    top: 0 !important;
    left: 0 !important;
    width: 100% !important;
  }
  
  #shopify-section-{{ section.id }} .banner__media img {
    object-fit: cover !important;
    height: 100% !important;
    width: 100% !important;
  }

  /* Force text overlay on mobile instead of below image */
  #shopify-section-{{ section.id }} .banner--mobile-bottom .slideshow__text-wrapper {
    position: absolute !important;
    height: 100% !important;
    top: 0 !important;
    left: 0 !important;
    width: 100% !important;
  }

  /* Content Positioning */
  #shopify-section-{{ section.id }} .slideshow__text-wrapper {
    position: absolute !important;
    height: 100% !important;
    width: 100% !important;
    top: 0 !important;
    left: 0 !important;
    padding: 0 !important;
    display: block !important;
  }

  #shopify-section-{{ section.id }} .slideshow__text {
    position: absolute !important;
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
    margin: 0 !important;
    text-align: left !important;
    padding: 0 !important;

    /* Mobile Positioning */
    left: 24px !important;
    bottom: 36px !important;
    width: calc(100% - 48px) !important;
    max-width: 100% !important;
  }

  @media screen and (min-width: 768px) {
    #shopify-section-{{ section.id }} .slideshow__text {
      left: 45px !important;
      bottom: 55px !important;
      width: 520px !important;
    }
  }

  @media screen and (min-width: 990px) {
    #shopify-section-{{ section.id }} .slideshow__text {
      left: 70px !important;
      bottom: 75px !important;
      width: 620px !important;
    }
  }

  /* Navigation Buttons (Arrows) */
  #shopify-section-{{ section.id }} .slideshow__controls {
    position: absolute !important;
    top: auto !important;
    left: auto !important;
    border: none !important;
    background: transparent !important;
    display: flex !important;
    z-index: 10 !important;
    justify-content: flex-end;
    width: max-content !important;
    
    /* Mobile Positioning */
    bottom: 36px !important;
    right: 24px !important;
    gap: 12px !important;
  }

  @media screen and (min-width: 990px) {
    #shopify-section-{{ section.id }} .slideshow__controls {
      bottom: 60px !important;
      right: 70px !important;
      gap: 16px !important;
    }
  }
  
  #shopify-section-{{ section.id }} .slider-counter,
  #shopify-section-{{ section.id }} .slideshow__autoplay {
    display: none !important; /* Hide defaults completely */
  }
  
  #shopify-section-{{ section.id }} .slider-button {
    width: 48px !important;
    height: 48px !important;
    border: 1px solid rgba(255, 255, 255, 0.75) !important;
    border-radius: 50% !important;
    background: transparent !important;
    color: #fff !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    transition: all 0.3s ease !important;
  }

  @media screen and (min-width: 990px) {
    #shopify-section-{{ section.id }} .slider-button {
      width: 64px !important;
      height: 64px !important;
    }
  }

  #shopify-section-{{ section.id }} .slider-button:hover {
    background: #fff !important;
    color: #000 !important;
  }

  #shopify-section-{{ section.id }} .slider-button svg {
    height: 18px !important;
    width: 18px !important;
    stroke-width: 1px;
    fill: none;
    stroke: currentColor;
  }

  /* Typography Base Overrides */
  .custom-slide-eyebrow {
    font-family: 'Begum', 'Cormorant Garamond', serif !important;
    text-transform: uppercase !important;
    line-height: 1.25 !important;
    letter-spacing: -0.02em !important;
    margin: 0 0 8px 0 !important;
    display: block;
  }

  .custom-slide-heading {
    font-family: 'Battlemade', 'Great Vibes', cursive !important;
    line-height: 1.25 !important;
    letter-spacing: -0.02em !important;
    margin: 0 0 34px 0 !important;
    display: block;
    position: relative;
    z-index: 2;
  }

  .custom-slide-desc {
    font-family: 'Gotham', 'Inter', sans-serif !important;
    line-height: 1.5 !important;
    margin: 0 0 42px 0 !important;
    display: -webkit-box;
    -webkit-line-clamp: 5;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Custom Button Styling */
  .slideshow__custom-btn {
    font-family: 'Gotham', 'Inter', sans-serif !important;
    background: transparent !important;
    font-weight: 400 !important;
    padding: 0 0 6px 0 !important;
    border: none !important;
    border-radius: 0 !important;
    display: inline-flex !important;
    align-items: center !important;
    gap: 8px !important;
    transition: all 0.3s ease !important;
    text-decoration: none !important;
    box-shadow: none !important;
    margin: 0 !important;
    position: relative;
  }

  .slideshow__custom-btn::after { 
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 90px;
    height: 1px;
    transition: width 0.3s ease;
  }

  .slideshow__custom-btn:hover::after {
    width: 100%;
  }

  .slideshow__custom-btn svg {
    width: 16px;
    height: 16px;
    transition: transform 0.3s ease;
  }

  .slideshow__custom-btn:hover svg {
    transform: translate(2px, -2px);
  }
</style>

{%- style -%}
  {%- for block in section.blocks -%}
    /* Dynamic Schema Based Styles */
    #Slide-{{ section.id }}-{{ forloop.index }} .banner__media::after {
      background-color: {{ section.settings.overlay_color }} !important;
      opacity: {{ block.settings.image_overlay_opacity | divided_by: 100.0 }} !important;
    }

    #Slide-{{ section.id }}-{{ forloop.index }} .custom-slide-eyebrow {
      color: {{ block.settings.eyebrow_color }} !important;
      font-size: {{ block.settings.eyebrow_size_mobile }}px !important;
      font-weight: {{ block.settings.eyebrow_weight }} !important;
    }
    
    #Slide-{{ section.id }}-{{ forloop.index }} .custom-slide-heading {
      color: {{ block.settings.heading_color }} !important;
      font-size: {{ block.settings.heading_size_mobile }}px !important;
      font-weight: {{ block.settings.heading_weight }} !important;
    }
    
    #Slide-{{ section.id }}-{{ forloop.index }} .custom-slide-desc {
      color: {{ block.settings.description_color }} !important;
      font-size: {{ block.settings.description_size_mobile }}px !important;
    }
    
    #Slide-{{ section.id }}-{{ forloop.index }} .slideshow__custom-btn {
      color: {{ block.settings.button_color }} !important;
      font-size: {{ block.settings.button_size_mobile }}px !important;
    }
    
    #Slide-{{ section.id }}-{{ forloop.index }} .slideshow__custom-btn::after {
      background-color: {{ block.settings.button_color }} !important;
    }

    @media screen and (min-width: 768px) {
      #Slide-{{ section.id }}-{{ forloop.index }} .custom-slide-eyebrow { font-size: {{ block.settings.eyebrow_size_tablet }}px !important; }
      #Slide-{{ section.id }}-{{ forloop.index }} .custom-slide-heading { font-size: {{ block.settings.heading_size_tablet }}px !important; }
      #Slide-{{ section.id }}-{{ forloop.index }} .custom-slide-desc { font-size: {{ block.settings.description_size_tablet }}px !important; }
    }

    @media screen and (min-width: 990px) {
      #Slide-{{ section.id }}-{{ forloop.index }} .custom-slide-eyebrow { font-size: {{ block.settings.eyebrow_size_desktop }}px !important; }
      #Slide-{{ section.id }}-{{ forloop.index }} .custom-slide-heading { font-size: {{ block.settings.heading_size_desktop }}px !important; }
      #Slide-{{ section.id }}-{{ forloop.index }} .custom-slide-desc { font-size: {{ block.settings.description_size_desktop }}px !important; }
      #Slide-{{ section.id }}-{{ forloop.index }} .slideshow__custom-btn { font-size: {{ block.settings.button_size_desktop }}px !important; }
    }
  {%- endfor -%}
{%- endstyle -%}

<slideshow-component
  class="slider-mobile-gutter{% if section.settings.layout == 'grid' %} page-width{% endif %}{% if section.settings.show_text_below %} mobile-text-below{% endif %}"
  role="region"
  aria-roledescription="{{ 'sections.slideshow.carousel' | t }}"
  aria-label="{{ section.settings.accessibility_info | escape }}"
>
  <div
    class="slideshow banner banner--{{ section.settings.slide_height }} grid grid--1-col slider slider--everywhere{% if section.settings.show_text_below %} banner--mobile-bottom{% endif %}{% if section.blocks.first.settings.image == blank %} slideshow--placeholder{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}"
    id="Slider-{{ section.id }}"
    aria-live="polite"
    aria-atomic="true"
    data-autoplay="{{ section.settings.auto_rotate }}"
    data-speed="{{ section.settings.change_slides_speed }}"
  >
    {%- for block in section.blocks -%}
      <div
        class="slideshow__slide grid__item grid--1-col slider__slide"
        id="Slide-{{ section.id }}-{{ forloop.index }}"
        {{ block.shopify_attributes }}
        role="group"
        aria-roledescription="{{ 'sections.slideshow.slide' | t }}"
        aria-label="{{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
        tabindex="-1"
      >
        <div class="slideshow__media banner__media media{% if block.settings.image == blank %} placeholder{% endif %}{% if section.settings.image_behavior != 'none' %} animate--{{ section.settings.image_behavior }}{% endif %}">
          {%- if block.settings.image -%}
            {%- liquid
              assign height = block.settings.image.width | divided_by: block.settings.image.aspect_ratio | round
              if section.settings.image_behavior == 'ambient'
                assign sizes = '120vw'
                assign widths = '450, 660, 900, 1320, 1800, 2136, 2400, 3600, 7680'
              else
                assign sizes = '100vw'
                assign widths = '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840'
              endif
              assign fetch_priority = 'auto'
              if section.index == 1
                assign fetch_priority = 'high'
              endif
            -%}
            {%- if forloop.first %}
              {{
                block.settings.image
                | image_url: width: 3840
                | image_tag: height: height, sizes: sizes, widths: widths, fetchpriority: fetch_priority
              }}
            {%- else -%}
              {{
                block.settings.image
                | image_url: width: 3840
                | image_tag: loading: 'lazy', height: height, sizes: sizes, widths: widths
              }}
            {%- endif -%}
          {%- else -%}
            {%- assign placeholder_slide = forloop.index | modulo: 2 -%}
            {%- if placeholder_slide == 1 -%}
              {{ 'hero-apparel-2' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- else -%}
              {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          {%- endif -%}
        </div>
        <div class="slideshow__text-wrapper banner__content banner__content--{{ block.settings.box_align }} page-width{% if block.settings.show_text_box == false %} banner--desktop-transparent{% endif %}{% if settings.animations_reveal_on_scroll and forloop.index == 1 %} scroll-trigger animate--slide-in{% endif %}">
          <div class="slideshow__text banner__box content-container content-container--full-width-mobile color-{{ block.settings.color_scheme }} gradient slideshow__text--{{ block.settings.text_alignment }} slideshow__text-mobile--{{ block.settings.text_alignment_mobile }}">
            
            {%- if block.settings.eyebrow != blank -%}
              <span class="custom-slide-eyebrow">
                {{ block.settings.eyebrow }}
              </span>
            {%- endif -%}

            {%- if block.settings.heading != blank -%}
              <h2 class="custom-slide-heading">
                {{ block.settings.heading }}
              </h2>
            {%- endif -%}
            
            {%- if block.settings.description != blank -%}
              <div class="custom-slide-desc rte">
                {{ block.settings.description }}
              </div>
            {%- endif -%}
            
            {%- if block.settings.button_label != blank -%}
              <a
                {% if block.settings.link %}
                  href="{{ block.settings.link }}"
                {% else %}
                  role="link" aria-disabled="true"
                {% endif %}
                class="slideshow__custom-btn"
              >
                {{- block.settings.button_label | escape -}}
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
              </a>
            {%- endif -%}
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>

  {%- if section.blocks.size > 1 and section.settings.auto_rotate == false -%}
    <div class="slideshow__controls slider-buttons">
      <button
        type="button"
        class="slider-button slider-button--prev"
        name="previous"
        aria-label="{{ 'sections.slideshow.previous_slideshow' | t }}"
        aria-controls="Slider-{{ section.id }}"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
      </button>
      <div class="slider-counter slider-counter--{{ section.settings.slider_visual }}{% if section.settings.slider_visual == 'counter' or section.settings.slider_visual == 'numbers' %} caption{% endif %}">
        {%- if section.settings.slider_visual == 'counter' -%}
          <span class="slider-counter--current">1</span>
          <span aria-hidden="true"> / </span>
          <span class="visually-hidden">{{ 'general.slider.of' | t }}</span>
          <span class="slider-counter--total">{{ section.blocks.size }}</span>
        {%- else -%}
          <div class="slideshow__control-wrapper">
            {%- for block in section.blocks -%}
              <button
                class="slider-counter__link slider-counter__link--{{ section.settings.slider_visual }} link"
                aria-label="{{ 'sections.slideshow.load_slide' | t }} {{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
                aria-controls="Slider-{{ section.id }}"
              >
                {%- if section.settings.slider_visual == 'numbers' -%}
                  {{ forloop.index -}}
                {%- else -%}
                  <span class="dot"></span>
                {%- endif -%}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
      <button
        type="button"
        class="slider-button slider-button--next"
        name="next"
        aria-label="{{ 'sections.slideshow.next_slideshow' | t }}"
        aria-controls="Slider-{{ section.id }}"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
      </button>

      {%- if section.settings.auto_rotate -%}
        <button
          type="button"
          class="slideshow__autoplay slider-button{% if section.settings.auto_rotate == false %} slideshow__autoplay--paused{% endif %}"
          aria-label="{{ 'sections.slideshow.pause_slideshow' | t }}"
        >
          <span class="svg-wrapper">
            {{- 'icon-pause.svg' | inline_asset_content -}}
          </span>
          <span class="svg-wrapper">
            {{- 'icon-play.svg' | inline_asset_content -}}
          </span>
        </button>
      {%- endif -%}
    </div>
  {%- endif -%}
</slideshow-component>

{%- if request.design_mode -%}
  <script src="{{ 'theme-editor.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.slideshow.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Luxury Banner Dimensions"
    },
    {
      "type": "range",
      "id": "height_desktop",
      "min": 400,
      "max": 1000,
      "step": 10,
      "unit": "px",
      "label": "Desktop Height",
      "default": 720
    },
    {
      "type": "range",
      "id": "height_tablet",
      "min": 400,
      "max": 1000,
      "step": 10,
      "unit": "px",
      "label": "Tablet Height",
      "default": 620
    },
    {
      "type": "range",
      "id": "height_mobile",
      "min": 300,
      "max": 900,
      "step": 10,
      "unit": "px",
      "label": "Mobile Height",
      "default": 520
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay Color",
      "default": "#000000"
    },
    {
      "type": "select",
      "id": "layout",
      "options": [
        {
          "value": "full_bleed",
          "label": "t:sections.slideshow.settings.layout.options__1.label"
        },
        {
          "value": "grid",
          "label": "t:sections.slideshow.settings.layout.options__2.label"
        }
      ],
      "default": "full_bleed",
      "label": "t:sections.slideshow.settings.layout.label"
    },
    {
      "type": "checkbox",
      "id": "auto_rotate",
      "label": "t:sections.slideshow.settings.auto_rotate.label",
      "default": false
    },
    {
      "type": "range",
      "id": "change_slides_speed",
      "min": 3,
      "max": 9,
      "step": 2,
      "unit": "s",
      "label": "t:sections.slideshow.settings.change_slides_speed.label",
      "default": 5
    },
    {
      "type": "select",
      "id": "image_behavior",
      "options": [
        {
          "value": "none",
          "label": "t:sections.all.animation.image_behavior.options__1.label"
        },
        {
          "value": "ambient",
          "label": "t:sections.all.animation.image_behavior.options__2.label"
        }
      ],
      "default": "none",
      "label": "t:sections.all.animation.image_behavior.label"
    },
    {
      "type": "header",
      "content": "t:sections.slideshow.settings.mobile.content"
    },
    {
      "type": "checkbox",
      "id": "show_text_below",
      "label": "t:sections.slideshow.settings.show_text_below.label",
      "default": false
    },
    {
      "type": "header",
      "content": "t:sections.slideshow.settings.accessibility.content"
    },
    {
      "type": "text",
      "id": "accessibility_info",
      "label": "t:sections.slideshow.settings.accessibility.label",
      "info": "t:sections.slideshow.settings.accessibility.info",
      "default": "t:sections.slideshow.settings.accessibility.default"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "t:sections.slideshow.blocks.slide.name",
      "limit": 5,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.slideshow.blocks.slide.settings.image.label"
        },
        {
          "type": "range",
          "id": "image_overlay_opacity",
          "min": 0,
          "max": 100,
          "step": 2,
          "unit": "%",
          "label": "t:sections.slideshow.blocks.slide.settings.image_overlay_opacity.label",
          "default": 22
        },
        {
          "type": "header",
          "content": "Eyebrow (First Line)"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "default": "TRADITION IN TRUST",
          "label": "Eyebrow Text"
        },
        {
          "type": "color",
          "id": "eyebrow_color",
          "label": "Eyebrow Color",
          "default": "#FFFFFF"
        },
        {
          "type": "range",
          "id": "eyebrow_size_desktop",
          "min": 10,
          "max": 100,
          "step": 1,
          "unit": "px",
          "label": "Desktop Size",
          "default": 45
        },
        {
          "type": "range",
          "id": "eyebrow_size_tablet",
          "min": 10,
          "max": 100,
          "step": 1,
          "unit": "px",
          "label": "Tablet Size",
          "default": 38
        },
        {
          "type": "range",
          "id": "eyebrow_size_mobile",
          "min": 10,
          "max": 100,
          "step": 1,
          "unit": "px",
          "label": "Mobile Size",
          "default": 22
        },
        {
          "type": "range",
          "id": "eyebrow_letter_spacing",
          "min": 0,
          "max": 10,
          "step": 0.5,
          "unit": "px",
          "label": "Letter Spacing",
          "default": 0
        },
        {
          "type": "select",
          "id": "eyebrow_weight",
          "label": "Font Weight",
          "options": [
            { "value": "400", "label": "400" },
            { "value": "500", "label": "500" },
            { "value": "600", "label": "600" },
            { "value": "700", "label": "700" }
          ],
          "default": "500"
        },
        {
          "type": "header",
          "content": "Heading (Handwritten)"
        },
        {
          "type": "text",
          "id": "heading",
          "default": "Brilliance for Today.",
          "label": "t:sections.slideshow.blocks.slide.settings.heading.label"
        },
        {
          "type": "color",
          "id": "heading_color",
          "label": "Heading Color",
          "default": "#FFFFFF"
        },
        {
          "type": "range",
          "id": "heading_size_desktop",
          "min": 20,
          "max": 150,
          "step": 2,
          "unit": "px",
          "label": "Desktop Size",
          "default": 128
        },
        {
          "type": "range",
          "id": "heading_size_tablet",
          "min": 20,
          "max": 120,
          "step": 2,
          "unit": "px",
          "label": "Tablet Size",
          "default": 96
        },
        {
          "type": "range",
          "id": "heading_size_mobile",
          "min": 10,
          "max": 100,
          "step": 1,
          "unit": "px",
          "label": "Mobile Size",
          "default": 54
        },
        {
          "type": "select",
          "id": "heading_weight",
          "label": "Font Weight",
          "options": [
            { "value": "300", "label": "300" },
            { "value": "400", "label": "400" },
            { "value": "500", "label": "500" },
            { "value": "600", "label": "600" }
          ],
          "default": "400"
        },
        {
          "type": "header",
          "content": "Description"
