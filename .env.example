# Environment Configuration (.env.example)

# -----------------------------------------------------------------------------
# 1. NODE & EXPRESS BACKEND API (services/api)
# -----------------------------------------------------------------------------
NODE_ENV=development
API_PORT=4000
API_HOST=0.0.0.0
STOREFRONT_PORT=9292
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
# Optional JSON persistence override. Relative paths resolve from services/api, not process.cwd().
MRS_DATA_FILE_PATH=

# Product image storage root (relative paths resolve from repo/API root; on VPS set e.g. /srv/mangal-royal-studio/product-assets)
PRODUCT_ASSETS_ROOT=./processed-product-assets

# JWT & Session Security (Backend Only — Never expose in browser)
JWT_SECRET=replace_with_32_byte_random_hex_secret_for_admin_jwt
SESSION_TTL_HOURS=24
CUSTOMER_SESSION_TTL_HOURS=24

# -----------------------------------------------------------------------------
# 2. POSTGRESQL DATABASE (Prisma ORM)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mangal_royal_studio?schema=public

# -----------------------------------------------------------------------------
# 3. SHOPIFY INTEGRATION (Server-side Admin API & Webhooks)
# -----------------------------------------------------------------------------
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_API_VERSION=2025-01
SHOPIFY_ADMIN_API_VERSION=2025-01
SHOPIFY_ADMIN_ACCESS_TOKEN=replace_me_shpat_token
SHOPIFY_API_SECRET=replace_me_api_secret
SHOPIFY_WEBHOOK_SECRET=replace_me_webhook_hmac_secret

# Safety gate: keep false in dev/staging so bulk jobs never write to live Shopify without explicit owner approval
SHOPIFY_LIVE_WRITES_ENABLED=false

# -----------------------------------------------------------------------------
# 4. RAZORPAY (Server-side order creation and payment status verification)
#    TEST MODE ONLY during Phase 5A. Live mode keys (rzp_live_*) are rejected.
# -----------------------------------------------------------------------------
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me_razorpay_test_key_secret
RAZORPAY_WEBHOOK_SECRET=replace_me_rzp_webhook_secret

# ----------------------------------------------------------------------------
# 5. CUSTOMER EMAIL VERIFICATION (Resend API)
#    Registration is disabled until all three values are configured.
# ----------------------------------------------------------------------------
RESEND_API_KEY=replace_me_resend_api_key
EMAIL_FROM=accounts@example.com
STOREFRONT_PUBLIC_URL=https://www.example.com

# ----------------------------------------------------------------------------
# 6. EXPRESS PROXY TRUST (optional, comma-separated trusted proxy CIDRs)
#    Leave empty when API is directly exposed; arbitrary X-Forwarded-For is ignored.
# ----------------------------------------------------------------------------
TRUSTED_PROXY_CIDRS=

# -----------------------------------------------------------------------------
# 7. SHIPROCKET LOGISTICS INTEGRATION (Backend Only)
# -----------------------------------------------------------------------------
SHIPROCKET_EMAIL=replace_me_shiprocket_email
SHIPROCKET_PASSWORD=replace_me_shiprocket_password
SHIPROCKET_WEBHOOK_SECRET=replace_me_shiprocket_webhook_token
SHIPROCKET_PICKUP_LOCATION=Primary_Mumbai_Studio

# -----------------------------------------------------------------------------
# 8. NEXT.JS STOREFRONT (apps/storefront) & ADMIN DASHBOARD (apps/admin)
#    NOTE: Never place secrets in NEXT_PUBLIC_* variables!
#    Preferred per-app names; existing NEXT_PUBLIC_API_URL and NEXT_PUBLIC_API_BASE_URL
#    aliases remain supported for deployments that already use them.
#    - apps/admin expects root API origin (e.g. http://localhost:4000)
#    - apps/storefront expects versioned API base (e.g. http://localhost:4000/api/v1)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_ADMIN_API_URL=http://localhost:4000
NEXT_PUBLIC_STOREFRONT_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Session cookies (HttpOnly always on). Secure is forced when NODE_ENV=production.
# COOKIE_SAMESITE: strict|lax|none (none requires HTTPS/Secure; only for cross-site deployments).
COOKIE_SECURE=false
COOKIE_SAMESITE=

# -----------------------------------------------------------------------------
# Seed account passwords (development / first-run only). Never commit real values.
# `seed-dev-auth.ts` refuses to run unless all three admin values are set (>= 14 chars, not a placeholder).
# The JSON store's first-run state uses them if present; otherwise seeded accounts are locked.
# Tests generate random values automatically and never read these from your shell.
# -----------------------------------------------------------------------------
MRS_SEED_OWNER_PASSWORD=replace_me_owner_seed_password
MRS_SEED_MANAGER_PASSWORD=replace_me_manager_seed_password
MRS_SEED_PRICING_PASSWORD=replace_me_pricing_seed_password
# Optional: password for the demo customer accounts in the JSON first-run state (unset = locked)
MRS_SEED_CUSTOMER_PASSWORD=
