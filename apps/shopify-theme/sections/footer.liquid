{% comment %}theme-check-disable UndefinedObject{% endcomment %}
{{ 'section-footer.css' | asset_url | stylesheet_tag }}
{{ 'component-newsletter.css' | asset_url | stylesheet_tag }}
{{ 'component-list-menu.css' | asset_url | stylesheet_tag }}
{{ 'component-list-payment.css' | asset_url | stylesheet_tag }}
{{ 'component-list-social.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .footer {
    margin-top: {{ section.settings.margin_top | times: 0.75 | round: 0 }}px;
  }
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .footer { margin-top: {{ section.settings.margin_top }}px; }
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  /* --- Luxury Footer Custom CSS --- */
  .custom-luxury-footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 4rem;
  }
  
  @media screen and (min-width: 990px) {
    .custom-luxury-footer-grid {
      grid-template-columns: 320px 1fr;
      gap: 5rem;
    }
  }

  /* Left Column (Brand/Text) */
  .footer-luxury-left {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  
  .footer-luxury-left .footer-block__details-content {
    font-size: 1.4rem;
    line-height: 1.6;
    letter-spacing: 0.5px;
    opacity: 0.9;
  }

  /* Right Column (Newsletter + Menus) */
  .footer-luxury-right {
    display: flex;
    flex-direction: column;
    gap: 4.5rem;
  }

  /* Newsletter Styling */
  .footer-luxury-newsletter {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 550px;
    margin: 0 auto;
    width: 100%;
  }

  .footer-luxury-newsletter h2 {
    font-family: 'Begum', serif; /* Or your theme's serif font */
    font-size: 3.6rem;
    font-weight: 500;
    margin-bottom: 2rem;
    letter-spacing: 1px;
    text-transform: none;
  }

  .footer-luxury-newsletter .newsletter-form__field-wrapper .field {
    display: flex;
    align-items: stretch;
  }
  
  .footer-luxury-newsletter .field:before,
  .footer-luxury-newsletter .field:after {
    display: none !important; /* Override Dawn default borders */
  }

  .footer-luxury-newsletter .field__input {
    border: 1px solid rgba(255, 255, 255, 0.4) !important;
    border-right: none !important;
    background: transparent !important;
    color: inherit !important;
    box-shadow: none !important;
    padding-left: 2rem;
  }
  
  .footer-luxury-newsletter .field__input:focus {
    border-color: rgba(255, 255, 255, 0.8) !important;
  }

  .footer-luxury-newsletter .newsletter-form__button {
    background-color: #fff !important;
    color: #7D1A2E !important; /* Adjust text color to match background */
    border: 1px solid #fff !important;
    width: auto !important;
    padding: 0 3rem !important;
    font-size: 1.3rem !important;
    font-weight: 600 !important;
    letter-spacing: 1.5px !important;
    text-transform: uppercase !important;
    margin: 0 !important;
    border-radius: 0 !important;
    position: relative;
  }
  
  .footer-luxury-newsletter .newsletter-form__button span { display: none; }
  .footer-luxury-newsletter .newsletter-form__button::after {
    content: "Subscribe";
  }

  /* Menus Styling */
  .footer-luxury-menus {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
  }

  .footer-luxury-menus .list-menu__item {
    font-size: 1.2rem;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    padding: 0.8rem 0;
    opacity: 0.8;
    transition: opacity 0.3s ease;
  }
  .footer-luxury-menus .list-menu__item:hover {
    opacity: 1;
  }

  @media screen and (min-width: 750px) {
    .footer-luxury-menus {
      grid-template-columns: repeat(4, 1fr);
      gap: 2rem;
    }
    .footer-accordion__summary {
      display: none !important; /* Hide headings on desktop to match screenshot */
    }
    .footer-accordion__content {
      display: block !important; /* Force open on desktop */
    }
    details.footer-accordion {
      border: none;
    }
  }

  /* Mobile Accordion Logic */
  @media screen and (max-width: 749px) {
    details.footer-accordion {
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }
    .footer-accordion__summary {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 1.5rem 0;
      cursor: pointer;
      list-style: none;
    }
    .footer-accordion__summary::-webkit-details-marker {
      display: none;
    }
    .footer-accordion__summary h2 {
      margin: 0;
      font-size: 1.5rem;
      letter-spacing: 1px;
      text-transform: uppercase;
    }
    .footer-accordion__content {
      padding-bottom: 1.5rem;
    }
    .accordion-icon {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 24px;
      height: 24px;
    }
    details[open] .icon-plus { display: none !important; }
    details[open] .icon-minus { display: block !important; }
  }

  /* Copyright Bar */
  .footer__content-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-top: 2rem !important;
    margin-top: 4rem;
  }
  .copyright__content {
    font-size: 1.2rem;
    opacity: 0.7;
    letter-spacing: 0.5px;
  }
{%- endstyle -%}

<footer class="footer color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  
  {%- liquid
    assign has_social_icons = true
    if settings.social_facebook_link == blank and settings.social_instagram_link == blank and settings.social_youtube_link == blank and settings.social_tiktok_link == blank and settings.social_twitter_link == blank and settings.social_pinterest_link == blank and settings.social_snapchat_link == blank and settings.social_tumblr_link == blank and settings.social_vimeo_link == blank
      assign has_social_icons = false
    endif
  -%}

  <div class="footer__content-top page-width custom-luxury-footer-grid">
    
    <!-- LEFT COLUMN: Brand Information / Logo / Text -->
    <div class="footer-luxury-left{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      {%- for block in section.blocks -%}
        {%- if block.type == 'brand_information' or block.type == 'image' or block.type == 'text' -%}
          <div class="footer-block" {{ block.shopify_attributes }}>
            
            {%- if block.type == 'brand_information' -%}
              <div class="footer-block__brand-info">
                {%- if settings.brand_image != blank -%}
                  {%- assign brand_image_height = settings.brand_image_width | divided_by: settings.brand_image.aspect_ratio -%}
                  <div class="footer-block__image-wrapper" style="max-width: min(100%, {{ settings.brand_image_width }}px); margin-bottom: 2rem;">
                    {{ settings.brand_image | image_url: width: 1100 | image_tag: loading: 'lazy', height: brand_image_height, width: settings.brand_image_width }}
                  </div>
                {%- endif -%}
                {%- if settings.brand_headline != blank -%}
                  <h2 class="footer-block__heading rte">{{ settings.brand_headline }}</h2>
                {%- endif -%}
                {%- if settings.brand_description != blank -%}
                  <div class="footer-block__details-content rte">{{ settings.brand_description }}</div>
                {%- endif -%}
              </div>
            {%- endif -%}

            {%- if block.type == 'image' -%}
              <div class="footer-block__image-wrapper" style="max-width: min(100%, {{ block.settings.image_width }}px); margin-bottom: 2rem;">
                {%- if block.settings.image != blank -%}
                  <img src="{{ block.settings.image | image_url: width: 400 }}" alt="{{ block.settings.image.alt | escape }}" loading="lazy" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}">
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg placeholder' }}
                {%- endif -%}
              </div>
            {%- endif -%}

            {%- if block.type == 'text' -%}
              {%- if block.settings.heading != blank -%}
                <h2 class="footer-block__heading inline-richtext">{{- block.settings.heading -}}</h2>
              {%- endif -%}
              <div class="footer-block__details-content rte">{{ block.settings.subtext }}</div>
            {%- endif -%}
            
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <!-- RIGHT COLUMN: Newsletter & Link Menus -->
    <div class="footer-luxury-right{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      
      {%- if section.settings.newsletter_enable -%}
        <div class="footer-luxury-newsletter">
          {%- if section.settings.newsletter_heading != blank -%}
            <h2>{{ section.settings.newsletter_heading }}</h2>
          {%- else -%}
            <h2>Join the mailing list</h2>
          {%- endif -%}

          {%- form 'customer', id: 'ContactFooter', class: 'footer__newsletter newsletter-form' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <div class="newsletter-form__field-wrapper">
              <div class="field">
                <input
                  id="NewsletterForm--{{ section.id }}"
                  type="email"
                  name="contact[email]"
                  class="field__input"
                  value="{{ form.email }}"
                  aria-required="true"
                  autocorrect="off"
                  autocapitalize="off"
                  autocomplete="email"
                  {% if form.errors %}
                    autofocus
                    aria-invalid="true"
                    aria-describedby="ContactFooter-error"
                  {% elsif form.posted_successfully? %}
                    aria-describedby="ContactFooter-success"
                  {% endif %}
                  placeholder="E-mail"
                  required
                >
                <label class="field__label visually-hidden" for="NewsletterForm--{{ section.id }}">E-mail</label>
                <button type="submit" class="newsletter-form__button field__button" name="commit" id="Subscribe" aria-label="Subscribe">
                  <!-- Text added via CSS ::after pseudoclass for exact design match -->
                </button>
              </div>
              {%- if form.errors -%}
                <small class="newsletter-form__message form__message" id="ContactFooter-error">
                  {{- form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email -}}
                </small>
              {%- endif -%}
            </div>
            {%- if form.posted_successfully? -%}
              <h3 class="newsletter-form__message newsletter-form__message--success form__message" id="ContactFooter-success" tabindex="-1" autofocus>
                {{- 'newsletter.success' | t }}
              </h3>
            {%- endif -%}
          {%- endform -%}
        </div>
      {%- endif -%}

      <div class="footer-luxury-menus">
        {%- for block in section.blocks -%}
          {%- if block.type == 'link_list' -%}
            <details class="footer-accordion" id="Details-{{ block.id }}-{{ section.id }}">
              <summary class="footer-accordion__summary">
                <h2>{{ block.settings.heading | default: 'Menu' }}</h2>
                <span class="accordion-icon">
                  <svg class="icon-plus" width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M7 1v12m-6-6h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                  <svg class="icon-minus" width="14" height="14" viewBox="0 0 14 14" fill="none" style="display:none;"><path d="M1 7h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                </span>
              </summary>
              <div class="footer-accordion__content">
                {%- if block.settings.menu != blank -%}
                  <ul class="list-unstyled">
                    {%- for link in block.settings.menu.links -%}
                      <li>
                        <a href="{{ link.url }}" class="link link--text list-menu__item list-menu__item--link{% if link.active %} list-menu__item--active{% endif %}">
                          {{ link.title | escape }}
                        </a>
                      </li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}
              </div>
            </details>
          {%- endif -%}
        {%- endfor -%}
      </div>

    </div>
  </div>

  <div class="footer__content-bottom{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
    <div class="footer__content-bottom-wrapper page-width">
      <div class="footer__copyright caption">
        <small class="copyright__content">
          &copy; {{ 'now' | date: '%Y' }}, All rights reserved by {{ shop.name }} | Developed by Fireflyz Tech
        </small>
        {%- if section.settings.show_policy -%}
          <ul class="policies list-unstyled" style="display: inline-flex; gap: 15px; margin-left: 15px;">
            {%- for policy in shop.policies -%}
              {%- if policy != blank -%}
                <li><small class="copyright__content"><a href="{{ policy.url }}" style="color: inherit; text-decoration: none;">{{ policy.title | escape }}</a></small></li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      <div class="footer__column footer__column--info">
        {%- if section.settings.payment_enable -%}
          <div class="footer__payment">
            <span class="visually-hidden">{{ 'sections.footer.payment' | t }}</span>
            <ul class="list list-payment" role="list">
              {%- for type in shop.enabled_payment_types -%}
                <li class="list-payment__item">
                  {{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "t:sections.footer.name",
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "link_list",
      "name": "t:sections.footer.blocks.link_list.name",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "default": "t:sections.footer.blocks.link_list.settings.heading.default",
          "label": "t:sections.footer.blocks.link_list.settings.heading.label",
          "info": "Used as the accordion heading on mobile."
        },
        {
          "type": "link_list",
          "id": "menu",
          "default": "footer",
          "label": "t:sections.footer.blocks.link_list.settings.menu.label"
        }
      ]
    },
    {
      "type": "brand_information",
      "name": "t:sections.footer.blocks.brand_information.name",
      "settings": [
        {
          "type": "paragraph",
          "content": "t:sections.footer.blocks.brand_information.settings.paragraph.content"
        }
      ]
    },
    {
      "type": "text",
      "name": "t:sections.footer.blocks.text.name",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "default": "t:sections.footer.blocks.text.settings.heading.default",
          "label": "t:sections.footer.blocks.text.settings.heading.label"
        },
        {
          "type": "richtext",
          "id": "subtext",
          "default": "t:sections.footer.blocks.text.settings.subtext.default",
          "label": "t:sections.footer.blocks.text.settings.subtext.label"
        }
      ]
    },
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "range",
          "id": "image_width",
          "min": 50,
          "max": 550,
          "step": 5,
          "unit": "px",
          "label": "Width",
          "default": 100
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.footer.settings.header__1.content",
      "info": "t:sections.footer.settings.header__1.info"
    },
    {
      "type": "checkbox",
      "id": "newsletter_enable",
      "default": true,
      "label": "t:sections.footer.settings.newsletter_enable.label"
    },
    {
      "type": "inline_richtext",
      "id": "newsletter_heading",
      "default": "Join the mailing list",
      "label": "t:sections.footer.settings.newsletter_heading.label"
    },
    {
      "type": "header",
      "content": "Additional Features"
    },
    {
      "type": "checkbox",
      "id": "payment_enable",
      "default": true,
      "label": "t:sections.footer.settings.payment_enable.label"
    },
    {
      "type": "checkbox",
      "id": "show_policy",
      "default": true,
      "label": "t:sections.footer.settings.show_policy.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.spacing"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.footer.settings.margin_top.label",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "default": {
    "blocks": [
      { "type": "link_list" },
      { "type": "text" }
    ]
  }
}
{% endschema %}