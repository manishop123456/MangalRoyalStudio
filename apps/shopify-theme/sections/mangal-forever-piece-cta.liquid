      "label": "Description size",
      "min": 10,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "select",
      "id": "mobile_description_line_height",
      "label": "Description line height",
      "options": [
        { "value": "1.2", "label": "Compact" },
        { "value": "1.4", "label": "Tight" },
        { "value": "1.5", "label": "Normal" },
        { "value": "1.6", "label": "Relaxed" },
        { "value": "1.8", "label": "Loose" }
      ],
      "default": "1.5"
    },
    {
      "type": "select",
      "id": "mobile_description_weight",
      "label": "Description weight",
      "options": [
