      "min": 400,
      "max": 900,
      "step": 20,
      "unit": "px",
      "default": 700
    },
    {
      "type": "range",
      "id": "desktop_description_top_spacing",
      "label": "Description top spacing",
      "min": 4,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 10
    },

    {
      "type": "header",
      "content": "Desktop buttons"
    },
    {
      "type": "select",
      "id": "desktop_button_font",
      "label": "Button font",
      "options": [
        { "value": "DM Sans", "label": "DM Sans" },
        { "value": "Montserrat", "label": "Montserrat" },
        { "value": "Arial", "label": "Arial" }
      ],
      "default": "DM Sans"
    },
    {
      "type": "range",
      "id": "desktop_button_size",
      "label": "Button text size",
      "min": 9,
      "max": 16,
      "step": 1,
      "unit": "px",
      "default": 10
    },
    {
      "type": "select",
      "id": "desktop_button_weight",
      "label": "Button text weight",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi bold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "500"
    },
    {
      "type": "range",
      "id": "desktop_button_letter_spacing",
      "label": "Button letter spacing",
      "min": 0,
      "max": 3,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "range",
      "id": "desktop_button_min_width",
      "label": "Button minimum width",
      "min": 100,
      "max": 220,
      "step": 5,
      "unit": "px",
      "default": 135
    },
    {
      "type": "range",
      "id": "desktop_button_height",
      "label": "Button height",
      "min": 30,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 34
    },
    {
      "type": "range",
      "id": "desktop_button_horizontal_padding",
      "label": "Button horizontal padding",
      "min": 10,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "desktop_button_gap",
      "label": "Button gap",
      "min": 4,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "desktop_buttons_top_spacing",
      "label": "Buttons top spacing",
      "min": 12,
      "max": 40,
      "step": 2,
