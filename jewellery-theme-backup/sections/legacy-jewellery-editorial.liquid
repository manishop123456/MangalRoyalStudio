{% liquid
  assign section_id = 'legacy-jewellery-' | append: section.id
%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Allura&family=Bodoni+Moda:wght@400;500;600;700&family=Cormorant+Garamond:wght@400;500;600;700&family=DM+Sans:wght@400;500;600&family=Montserrat:wght@400;500;600&family=Playfair+Display:wght@400;500;600;700&display=swap');

  /* =========================================================
     VARIABLES
  ========================================================= */

  #{{ section_id }} {
    --lj-background: {{ section.settings.background_color }};
    --lj-eyebrow-color: {{ section.settings.eyebrow_color }};
    --lj-heading-color: {{ section.settings.heading_color }};
    --lj-body-color: {{ section.settings.body_color }};
    --lj-quote-color: {{ section.settings.quote_color }};
    --lj-image-border: {{ section.settings.image_border_color }};

    /* Desktop */
    --lj-desktop-max-width: {{ section.settings.desktop_max_width }}px;

    --lj-desktop-padding-top: {{ section.settings.desktop_padding_top }}px;
    --lj-desktop-padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
    --lj-desktop-padding-left: {{ section.settings.desktop_padding_left }}px;
    --lj-desktop-padding-right: {{ section.settings.desktop_padding_right }}px;

    --lj-desktop-column-gap: {{ section.settings.desktop_column_gap }}px;

    --lj-desktop-image-area-width: {{ section.settings.desktop_image_area_width }}%;
    --lj-desktop-content-width: {{ section.settings.desktop_content_width }}%;

    --lj-desktop-content-offset: {{ section.settings.desktop_content_offset }}px;

    --lj-desktop-back-width: {{ section.settings.desktop_back_image_width }}px;
    --lj-desktop-back-height: {{ section.settings.desktop_back_image_height }}px;

    --lj-desktop-front-width: {{ section.settings.desktop_front_image_width }}px;
    --lj-desktop-front-height: {{ section.settings.desktop_front_image_height }}px;

    --lj-desktop-back-top: {{ section.settings.desktop_back_image_top }}px;
    --lj-desktop-back-left: {{ section.settings.desktop_back_image_left }}px;

    --lj-desktop-front-top: {{ section.settings.desktop_front_image_top }}px;
    --lj-desktop-front-left: {{ section.settings.desktop_front_image_left }}px;

    --lj-desktop-image-border-width: {{ section.settings.desktop_image_border_width }}px;

    --lj-desktop-eyebrow-size: {{ section.settings.desktop_eyebrow_size }}px;
    --lj-desktop-heading-size: {{ section.settings.desktop_heading_size }}px;
    --lj-desktop-body-size: {{ section.settings.desktop_body_size }}px;
    --lj-desktop-quote-size: {{ section.settings.desktop_quote_size }}px;

    --lj-desktop-eyebrow-line-height: {{ section.settings.desktop_eyebrow_line_height }};
    --lj-desktop-heading-line-height: {{ section.settings.desktop_heading_line_height }};
    --lj-desktop-body-line-height: {{ section.settings.desktop_body_line_height }};
    --lj-desktop-quote-line-height: {{ section.settings.desktop_quote_line_height }};

    --lj-desktop-eyebrow-margin: {{ section.settings.desktop_eyebrow_margin }}px;
    --lj-desktop-heading-margin: {{ section.settings.desktop_heading_margin }}px;
    --lj-desktop-paragraph-gap: {{ section.settings.desktop_paragraph_gap }}px;
    --lj-desktop-quote-margin: {{ section.settings.desktop_quote_margin }}px;

    /* Mobile */
    --lj-mobile-padding-top: {{ section.settings.mobile_padding_top }}px;
    --lj-mobile-padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    --lj-mobile-padding-left: {{ section.settings.mobile_padding_left }}px;
    --lj-mobile-padding-right: {{ section.settings.mobile_padding_right }}px;

    --lj-mobile-image-gap: {{ section.settings.mobile_image_gap }}px;

    --lj-mobile-back-width: {{ section.settings.mobile_back_image_width }}px;
    --lj-mobile-back-height: {{ section.settings.mobile_back_image_height }}px;

    --lj-mobile-front-width: {{ section.settings.mobile_front_image_width }}px;
    --lj-mobile-front-height: {{ section.settings.mobile_front_image_height }}px;

    --lj-mobile-back-top: {{ section.settings.mobile_back_image_top }}px;
    --lj-mobile-back-left: {{ section.settings.mobile_back_image_left }}px;

    --lj-mobile-front-top: {{ section.settings.mobile_front_image_top }}px;
    --lj-mobile-front-left: {{ section.settings.mobile_front_image_left }}px;

    --lj-mobile-image-border-width: {{ section.settings.mobile_image_border_width }}px;

    --lj-mobile-eyebrow-size: {{ section.settings.mobile_eyebrow_size }}px;
    --lj-mobile-heading-size: {{ section.settings.mobile_heading_size }}px;
    --lj-mobile-body-size: {{ section.settings.mobile_body_size }}px;
    --lj-mobile-quote-size: {{ section.settings.mobile_quote_size }}px;

    --lj-mobile-eyebrow-line-height: {{ section.settings.mobile_eyebrow_line_height }};
    --lj-mobile-heading-line-height: {{ section.settings.mobile_heading_line_height }};
    --lj-mobile-body-line-height: {{ section.settings.mobile_body_line_height }};
    --lj-mobile-quote-line-height: {{ section.settings.mobile_quote_line_height }};

    --lj-mobile-eyebrow-margin: {{ section.settings.mobile_eyebrow_margin }}px;
    --lj-mobile-heading-margin: {{ section.settings.mobile_heading_margin }}px;
    --lj-mobile-paragraph-gap: {{ section.settings.mobile_paragraph_gap }}px;
    --lj-mobile-quote-margin: {{ section.settings.mobile_quote_margin }}px;
  }


  /* =========================================================
     RESET / ROOT
  ========================================================= */

  #{{ section_id }} {
    width: 100%;
    max-width: 100%;
    background: var(--lj-background);
    box-sizing: border-box;
    overflow: hidden;
  }

  #{{ section_id }} *,
  #{{ section_id }} *::before,
  #{{ section_id }} *::after {
    box-sizing: border-box;
  }


  /* =========================================================
     DESKTOP CONTAINER
  ========================================================= */

  #{{ section_id }} .lj-container {
    width: 100%;
    max-width: var(--lj-desktop-max-width);

    margin: 0 auto;

    padding-top: var(--lj-desktop-padding-top);
    padding-bottom: var(--lj-desktop-padding-bottom);
    padding-left: var(--lj-desktop-padding-left);
    padding-right: var(--lj-desktop-padding-right);
  }


  /* =========================================================
     DESKTOP GRID
  ========================================================= */

  #{{ section_id }} .lj-grid {
    display: flex;

    align-items: center;
    justify-content: space-between;

    width: 100%;

    gap: var(--lj-desktop-column-gap);
  }


  /* =========================================================
     DESKTOP IMAGE COLUMN
  ========================================================= */

  #{{ section_id }} .lj-image-column {
    position: relative;

    width: var(--lj-desktop-image-area-width);
    flex: 0 0 var(--lj-desktop-image-area-width);

    height: max(
      var(--lj-desktop-back-height),
      calc(
        var(--lj-desktop-front-top) +
        var(--lj-desktop-front-height)
      )
    );

    min-height: 500px;

    overflow: visible;
  }


  /* =========================================================
     DESKTOP IMAGE STAGE
  ========================================================= */

  #{{ section_id }} .lj-image-stage {
    position: relative;

    width: 100%;
    height: 100%;

    overflow: visible;
  }


  /* =========================================================
     COMMON IMAGE
  ========================================================= */

  #{{ section_id }} .lj-image {
    position: absolute;

    display: block;

    object-fit: cover;
    object-position: center center;

    background: #f5f5f5;

    border-style: solid;
    border-color: var(--lj-image-border);
    border-width: var(--lj-desktop-image-border-width);

    margin: 0;
    padding: 0;
  }


  /* =========================================================
     DESKTOP BACK IMAGE
  ========================================================= */

  #{{ section_id }} .lj-back-image {
    width: var(--lj-desktop-back-width);
    height: var(--lj-desktop-back-height);

    top: var(--lj-desktop-back-top);
    left: var(--lj-desktop-back-left);

    z-index: 1;
  }


  /* =========================================================
     DESKTOP FRONT IMAGE
  ========================================================= */

  #{{ section_id }} .lj-front-image {
    width: var(--lj-desktop-front-width);
    height: var(--lj-desktop-front-height);

    top: var(--lj-desktop-front-top);
    left: var(--lj-desktop-front-left);

    z-index: 2;
  }


  /* =========================================================
     PLACEHOLDERS
  ========================================================= */

  #{{ section_id }} .lj-image-placeholder {
    position: absolute;

    display: flex;

    align-items: center;
    justify-content: center;

    background: #eeeeee;
    color: #777777;

    text-align: center;

    font-family: Arial, sans-serif;
    font-size: 12px;

    border-style: solid;
    border-color: var(--lj-image-border);
    border-width: var(--lj-desktop-image-border-width);

    overflow: hidden;
  }

  #{{ section_id }} .lj-back-placeholder {
    width: var(--lj-desktop-back-width);
    height: var(--lj-desktop-back-height);

    top: var(--lj-desktop-back-top);
    left: var(--lj-desktop-back-left);

    z-index: 1;
  }

  #{{ section_id }} .lj-front-placeholder {
    width: var(--lj-desktop-front-width);
    height: var(--lj-desktop-front-height);

    top: var(--lj-desktop-front-top);
    left: var(--lj-desktop-front-left);

    z-index: 2;
  }


  /* =========================================================
     DESKTOP CONTENT
  ========================================================= */

  #{{ section_id }} .lj-content {
    width: var(--lj-desktop-content-width);
    flex: 0 0 var(--lj-desktop-content-width);

    padding-top: var(--lj-desktop-content-offset);

    min-width: 0;
  }


  /* =========================================================
     EYEBROW
  ========================================================= */

  #{{ section_id }} .lj-eyebrow {
    margin: 0 0 var(--lj-desktop-eyebrow-margin);

    color: var(--lj-eyebrow-color);

    font-family: 'Allura', cursive;

    font-size: var(--lj-desktop-eyebrow-size);
    line-height: var(--lj-desktop-eyebrow-line-height);

    font-weight: 400;

    letter-spacing: {{ section.settings.eyebrow_letter_spacing }}px;
  }


  /* =========================================================
     HEADING
  ========================================================= */

  #{{ section_id }} .lj-heading {
    margin: 0 0 var(--lj-desktop-heading-margin);

    color: var(--lj-heading-color);

    font-family: '{{ section.settings.heading_font }}', serif;

    font-size: var(--lj-desktop-heading-size);
    line-height: var(--lj-desktop-heading-line-height);

    font-weight: {{ section.settings.heading_weight }};

    letter-spacing: {{ section.settings.heading_letter_spacing }}px;

    text-transform: {{ section.settings.heading_transform }};

    word-break: normal;
    overflow-wrap: normal;
  }


  /* =========================================================
     BODY
  ========================================================= */

  #{{ section_id }} .lj-body {
    color: var(--lj-body-color);

    font-family: '{{ section.settings.body_font }}', sans-serif;

    font-size: var(--lj-desktop-body-size);
    line-height: var(--lj-desktop-body-line-height);

    font-weight: {{ section.settings.body_weight }};

    letter-spacing: {{ section.settings.body_letter_spacing }}px;
  }

  #{{ section_id }} .lj-body p {
    margin: 0 0 var(--lj-desktop-paragraph-gap);
  }

  #{{ section_id }} .lj-body p:last-child {
    margin-bottom: 0;
  }


  /* =========================================================
     QUOTE
  ========================================================= */

  #{{ section_id }} .lj-quote {
    margin: var(--lj-desktop-quote-margin) 0 0;

    color: var(--lj-quote-color);

    font-family: '{{ section.settings.quote_font }}', serif;

    font-size: var(--lj-desktop-quote-size);
    line-height: var(--lj-desktop-quote-line-height);

    font-weight: {{ section.settings.quote_weight }};

    letter-spacing: {{ section.settings.quote_letter_spacing }}px;
  }


  /* =========================================================
     MOBILE
     
     IMPORTANT:
     Completely different layout.
     
     Image stage is a separate physical block.
     Content comes AFTER it in normal document flow.
  ========================================================= */

  @media screen and (max-width: 749px) {

    #{{ section_id }} {
      width: 100%;
      max-width: 100%;

      overflow-x: hidden;
      overflow-y: visible;

      position: relative;

      isolation: isolate;
    }


    /* -------------------------------------------------------
       MOBILE CONTAINER
    ------------------------------------------------------- */

    #{{ section_id }} .lj-container {
      width: 100%;
      max-width: 100%;

      margin: 0;

      padding-top: var(--lj-mobile-padding-top);
      padding-bottom: var(--lj-mobile-padding-bottom);
      padding-left: var(--lj-mobile-padding-left);
      padding-right: var(--lj-mobile-padding-right);

      overflow: visible;
    }


    /* -------------------------------------------------------
       MOBILE GRID
    ------------------------------------------------------- */

    #{{ section_id }} .lj-grid {
      display: flex;

      flex-direction: column;

      align-items: stretch;
      justify-content: flex-start;

      width: 100%;
      max-width: 100%;

      gap: 0;

      margin: 0;
      padding: 0;
    }


    /* =======================================================
       MOBILE IMAGE COLUMN
       
       THIS IS THE CRITICAL FIX.
       
       The column has a real height.
       The image stage lives INSIDE it.
       Content comes after this block.
    ======================================================= */

    #{{ section_id }} .lj-image-column {
      position: relative;

      display: block;

      width: 100%;
      max-width: 100%;

      /*
        420px is the mobile composition area.

        Images may overlap each other inside this area,
        but cannot affect the content block below.
      */
      height: 420px;
      min-height: 420px;

      flex: 0 0 420px;

      margin: 0 0 var(--lj-mobile-image-gap);

      padding: 0;

      overflow: visible;

      order: 1;

      isolation: isolate;
    }


    /* =======================================================
       MOBILE IMAGE STAGE
    ======================================================= */

    #{{ section_id }} .lj-image-stage {
      position: relative;

      display: block;

      width: 100%;
      height: 420px;

      margin: 0;
      padding: 0;

      overflow: visible;
    }


    /* =======================================================
       MOBILE COMMON IMAGE
    ======================================================= */

    #{{ section_id }} .lj-image {
      position: absolute;

      display: block;

      object-fit: cover;
      object-position: center center;

      margin: 0;
      padding: 0;

      border-style: solid;
      border-color: var(--lj-image-border);

      border-width: var(--lj-mobile-image-border-width);

      max-width: none;
    }


    /* =======================================================
       MOBILE BACK IMAGE
       
       Responsive width prevents horizontal overflow.
    ======================================================= */

    #{{ section_id }} .lj-back-image {
      top: 0;
      left: 0;

      width: min(
        var(--lj-mobile-back-width),
        calc(100% - 35px)
      );

      max-width: calc(100% - 35px);

      height: var(--lj-mobile-back-height);

      z-index: 1;
    }


    /* =======================================================
       MOBILE FRONT IMAGE
       
       Always stays inside the image stage.
    ======================================================= */

    #{{ section_id }} .lj-front-image {
      top: 155px;
      left: 45px;

      width: min(
        var(--lj-mobile-front-width),
        calc(100% - 45px)
      );

      max-width: calc(100% - 45px);

      height: var(--lj-mobile-front-height);

      z-index: 2;
    }


    /* =======================================================
       MOBILE BACK PLACEHOLDER
    ======================================================= */

    #{{ section_id }} .lj-back-placeholder {
      top: 0;
      left: 0;

      width: min(
        var(--lj-mobile-back-width),
        calc(100% - 35px)
      );

      max-width: calc(100% - 35px);

      height: var(--lj-mobile-back-height);

      border-width: var(--lj-mobile-image-border-width);

      z-index: 1;
    }


    /* =======================================================
       MOBILE FRONT PLACEHOLDER
    ======================================================= */

    #{{ section_id }} .lj-front-placeholder {
      top: 155px;
      left: 45px;

      width: min(
        var(--lj-mobile-front-width),
        calc(100% - 45px)
      );

      max-width: calc(100% - 45px);

      height: var(--lj-mobile-front-height);

      border-width: var(--lj-mobile-image-border-width);

      z-index: 2;
    }


    /* =======================================================
       MOBILE CONTENT
       
       NO absolute position.
       NO negative margin.
       NO transform.
       
       It exists AFTER the image column.
    ======================================================= */

    #{{ section_id }} .lj-content {
      position: relative;

      display: block;

      width: 100%;
      max-width: 100%;

      height: auto;
      min-height: 0;

      margin: 0;
      padding: 0;

      flex: 0 0 auto;

      order: 2;

      clear: both;

      float: none;

      transform: none;

      overflow: visible;

      text-align: {{ section.settings.mobile_text_alignment }};

      z-index: 10;
    }


    /* =======================================================
       MOBILE EYEBROW
    ======================================================= */

    #{{ section_id }} .lj-eyebrow {
      display: block;

      width: 100%;
      max-width: 100%;

      margin-top: 0;
      margin-right: 0;
      margin-bottom: var(--lj-mobile-eyebrow-margin);
      margin-left: 0;

      padding: 0;

      color: var(--lj-eyebrow-color);

      font-family: 'Allura', cursive;

      font-size: var(--lj-mobile-eyebrow-size);
      line-height: var(--lj-mobile-eyebrow-line-height);

      font-weight: 400;

      letter-spacing: {{ section.settings.eyebrow_letter_spacing }}px;

      white-space: normal;

      overflow: visible;
    }


    /* =======================================================
       MOBILE HEADING
    ======================================================= */

    #{{ section_id }} .lj-heading {
      display: block;

      width: 100%;
      max-width: 100%;

      margin-top: 0;
      margin-right: 0;
      margin-bottom: var(--lj-mobile-heading-margin);
      margin-left: 0;

      padding: 0;

      color: var(--lj-heading-color);

      font-family: '{{ section.settings.heading_font }}', serif;

      font-size: var(--lj-mobile-heading-size);
      line-height: var(--lj-mobile-heading-line-height);

      font-weight: {{ section.settings.heading_weight }};

      letter-spacing: {{ section.settings.heading_letter_spacing }}px;

      text-transform: {{ section.settings.heading_transform }};

      white-space: normal;

      word-break: normal;

      overflow-wrap: normal;

      hyphens: none;
    }


    /* =======================================================
       MOBILE BODY
    ======================================================= */

    #{{ section_id }} .lj-body {
      display: block;

      width: 100%;
      max-width: 100%;

      margin: 0;
      padding: 0;

      color: var(--lj-body-color);

      font-family: '{{ section.settings.body_font }}', sans-serif;

      font-size: var(--lj-mobile-body-size);
      line-height: var(--lj-mobile-body-line-height);

      font-weight: {{ section.settings.body_weight }};

      letter-spacing: {{ section.settings.body_letter_spacing }}px;

      overflow: visible;
    }


    #{{ section_id }} .lj-body p {
      display: block;

      width: 100%;
      max-width: 100%;

      margin-top: 0;
      margin-right: 0;
      margin-bottom: var(--lj-mobile-paragraph-gap);
      margin-left: 0;

      padding: 0;

      overflow-wrap: break-word;
      word-break: normal;
    }


    #{{ section_id }} .lj-body p:last-child {
      margin-bottom: 0;
    }


    /* =======================================================
       MOBILE QUOTE
    ======================================================= */

    #{{ section_id }} .lj-quote {
      display: block;

      width: 100%;
      max-width: 100%;

      margin-top: var(--lj-mobile-quote-margin);
      margin-right: 0;
      margin-bottom: 0;
      margin-left: 0;

      padding: 0;

      color: var(--lj-quote-color);

      font-family: '{{ section.settings.quote_font }}', serif;

      font-size: var(--lj-mobile-quote-size);
      line-height: var(--lj-mobile-quote-line-height);

      font-weight: {{ section.settings.quote_weight }};

      letter-spacing: {{ section.settings.quote_letter_spacing }}px;

      overflow-wrap: break-word;
    }


    /* =======================================================
       TABLET / LARGE MOBILE
       480px - 749px
    ======================================================= */

    @media screen and (min-width: 480px) and (max-width: 749px) {

      #{{ section_id }} .lj-image-column {
        height: 430px;
        min-height: 430px;
        flex-basis: 430px;
      }

      #{{ section_id }} .lj-image-stage {
        height: 430px;
      }

      #{{ section_id }} .lj-back-image,
      #{{ section_id }} .lj-back-placeholder {
        width: min(
          var(--lj-mobile-back-width),
          78%
        );

        max-width: 78%;

        height: 210px;
      }

      #{{ section_id }} .lj-front-image,
      #{{ section_id }} .lj-front-placeholder {
        top: 160px;
        left: 45px;

        width: min(
          var(--lj-mobile-front-width),
          calc(100% - 45px)
        );

        max-width: calc(100% - 45px);

        height: 220px;
      }

      #{{ section_id }} .lj-heading {
        font-size: var(--lj-mobile-heading-size);
        line-height: var(--lj-mobile-heading-line-height);
      }
    }


    /* =======================================================
       NORMAL PHONE
       375px - 479px
    ======================================================= */

    @media screen and (min-width: 375px) and (max-width: 479px) {

      #{{ section_id }} .lj-image-column {
        height: 395px;
        min-height: 395px;
        flex-basis: 395px;
      }

      #{{ section_id }} .lj-image-stage {
        height: 395px;
      }

      #{{ section_id }} .lj-back-image,
      #{{ section_id }} .lj-back-placeholder {
        width: calc(100% - 35px);
        max-width: calc(100% - 35px);

        height: 190px;
      }

      #{{ section_id }} .lj-front-image,
      #{{ section_id }} .lj-front-placeholder {
        top: 145px;
        left: 40px;

        width: calc(100% - 40px);
        max-width: calc(100% - 40px);

        height: 205px;
      }

      #{{ section_id }} .lj-eyebrow {
        font-size: 25px;
        line-height: 1;
      }

      #{{ section_id }} .lj-heading {
        font-size: 32px;
        line-height: 0.9;
        letter-spacing: -0.2px;
      }

      #{{ section_id }} .lj-body {
        font-size: 14px;
        line-height: 1.55;
      }

      #{{ section_id }} .lj-quote {
        font-size: 18px;
        line-height: 1.2;
      }
    }


    /* =======================================================
       SMALL PHONE
       320px - 374px
    ======================================================= */

    @media screen and (max-width: 374px) {

      #{{ section_id }} .lj-container {
        padding-left: 15px;
        padding-right: 15px;
      }

      #{{ section_id }} .lj-image-column {
        height: 350px;
        min-height: 350px;
        flex-basis: 350px;

        margin-bottom: 35px;
      }

      #{{ section_id }} .lj-image-stage {
        height: 350px;
      }

      #{{ section_id }} .lj-back-image,
      #{{ section_id }} .lj-back-placeholder {
        top: 0;
        left: 0;

        width: calc(100% - 25px);
        max-width: calc(100% - 25px);

        height: 165px;
      }

      #{{ section_id }} .lj-front-image,
      #{{ section_id }} .lj-front-placeholder {
        top: 130px;
        left: 30px;

        width: calc(100% - 30px);
        max-width: calc(100% - 30px);

        height: 185px;
      }

      #{{ section_id }} .lj-eyebrow {
        font-size: 23px;
        line-height: 1;
      }

      #{{ section_id }} .lj-heading {
        font-size: 29px;
        line-height: 0.9;
        letter-spacing: -0.2px;
      }

      #{{ section_id }} .lj-body {
        font-size: 13px;
        line-height: 1.55;
      }

      #{{ section_id }} .lj-quote {
        font-size: 18px;
        line-height: 1.2;
      }
    }


    /* =======================================================
       VERY SMALL PHONE
       BELOW 320px
    ======================================================= */

    @media screen and (max-width: 319px) {

      #{{ section_id }} .lj-container {
        padding-left: 12px;
        padding-right: 12px;
      }

      #{{ section_id }} .lj-image-column {
        height: 320px;
        min-height: 320px;
        flex-basis: 320px;

        margin-bottom: 30px;
      }

      #{{ section_id }} .lj-image-stage {
        height: 320px;
      }

      #{{ section_id }} .lj-back-image,
      #{{ section_id }} .lj-back-placeholder {
        width: calc(100% - 20px);
        max-width: calc(100% - 20px);

        height: 150px;
      }

      #{{ section_id }} .lj-front-image,
      #{{ section_id }} .lj-front-placeholder {
        top: 120px;
        left: 20px;

        width: calc(100% - 20px);
        max-width: calc(100% - 20px);

        height: 170px;
      }

      #{{ section_id }} .lj-eyebrow {
        font-size: 21px;
      }

      #{{ section_id }} .lj-heading {
        font-size: 27px;
        line-height: 0.9;
      }

      #{{ section_id }} .lj-body {
        font-size: 13px;
        line-height: 1.5;
      }
    }
  }
</style>


<section
  id="{{ section_id }}"
  class="legacy-jewellery-editorial"
  aria-label="{{ section.settings.accessibility_label | escape }}"
>

  <div class="lj-container">

    <div class="lj-grid">

      <!-- =====================================================
           IMAGE COLUMN
      ====================================================== -->

      <div class="lj-image-column">

        <div class="lj-image-stage">

          {% if section.settings.back_image != blank %}

            <img
              class="lj-image lj-back-image"
              src="{{ section.settings.back_image | image_url: width: 1200 }}"
              srcset="
                {{ section.settings.back_image | image_url: width: 500 }} 500w,
                {{ section.settings.back_image | image_url: width: 750 }} 750w,
                {{ section.settings.back_image | image_url: width: 1000 }} 1000w,
                {{ section.settings.back_image | image_url: width: 1200 }} 1200w
              "
              sizes="(min-width: 750px) 50vw, 90vw"
              alt="{{ section.settings.back_image.alt | escape }}"
              loading="{{ section.settings.image_loading }}"
            >

          {% else %}

            <div class="lj-image-placeholder lj-back-placeholder">
              Add back image
            </div>

          {% endif %}


          {% if section.settings.front_image != blank %}

            <img
              class="lj-image lj-front-image"
              src="{{ section.settings.front_image | image_url: width: 1200 }}"
              srcset="
                {{ section.settings.front_image | image_url: width: 500 }} 500w,
                {{ section.settings.front_image | image_url: width: 750 }} 750w,
                {{ section.settings.front_image | image_url: width: 1000 }} 1000w,
                {{ section.settings.front_image | image_url: width: 1200 }} 1200w
              "
              sizes="(min-width: 750px) 50vw, 90vw"
              alt="{{ section.settings.front_image.alt | escape }}"
              loading="{{ section.settings.image_loading }}"
            >

          {% else %}

            <div class="lj-image-placeholder lj-front-placeholder">
              Add front image
            </div>

          {% endif %}

        </div>

      </div>


      <!-- =====================================================
           CONTENT COLUMN
      ====================================================== -->

      <div class="lj-content">

        {% if section.settings.eyebrow != blank %}

          <div class="lj-eyebrow">
            {{ section.settings.eyebrow }}
          </div>

        {% endif %}


        {% if section.settings.heading != blank %}

          <h2 class="lj-heading">
            {{ section.settings.heading | newline_to_br }}
          </h2>

        {% endif %}


        {% if section.settings.body_text != blank %}

          <div class="lj-body">
            {{ section.settings.body_text }}
          </div>

        {% endif %}


        {% if section.settings.quote != blank %}

          <div class="lj-quote">
            {{ section.settings.quote | newline_to_br }}
          </div>

        {% endif %}

      </div>

    </div>

  </div>

</section>


