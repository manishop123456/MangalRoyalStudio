{%- comment -%}
  ============================================================================
  WHY LAB GROWN — Premium editorial split section (OS 2.0, theme agnostic)
  ----------------------------------------------------------------------------
  File: sections/why-lab-grown.liquid

  Self-contained: Liquid + HTML + CSS + vanilla JS in one file. No snippets,
  no external assets, no libraries. Runs unchanged in Dawn, Prestige, Impulse,
  Enterprise and any other Online Store 2.0 theme.

  FONTS
  Battlemade, Begum and Gotham are licensed faces and are not on Shopify's CDN.
  Upload the .woff2 files to Assets and enter the file names in the section
  settings — the @font-face rules build themselves. Lato loads from Shopify's
  own font library through the font picker, so it needs no upload and covers
  the Gotham fallback and the button.

  GEOMETRY (measured from the Figma, not rounded)
  Container 1440 · padding 90/70 · content box 1300
  Two 650px columns. The 56px column gap is padding INSIDE the content column,
  which is how the Figma keeps the image at a true 650px (a real 56px grid gap
  would shrink it to 622px). Image 650x795. Content column 650x650.
  ============================================================================
{%- endcomment -%}

{%- liquid
  assign s = section.settings

  assign body_font = s.body_font
  assign body_font_medium = body_font | font_modify: 'weight', '500'
  assign body_font_bold = body_font | font_modify: 'weight', '600'

  assign side_padding = s.padding_left | plus: s.padding_right

  assign image_alt = s.image.alt | default: s.heading | default: 'Why lab grown'

  capture sizes_attr
    echo '(min-width: 990px) calc((min(100vw, '
    echo s.container_width
    echo 'px) - '
    echo side_padding
    echo 'px) / 2), 100vw'
  endcapture

  assign root_classes = 'wlg wlg-' | append: section.id
  if s.enable_hover
    assign root_classes = root_classes | append: ' wlg--hover'
  endif
  if s.enable_animation
    assign root_classes = root_classes | append: ' wlg--animate'
  endif
-%}

<style>
  {{ body_font | font_face: font_display: 'swap' }}
  {%- if body_font_medium -%}{{ body_font_medium | font_face: font_display: 'swap' }}{%- endif -%}
  {%- if body_font_bold -%}{{ body_font_bold | font_face: font_display: 'swap' }}{%- endif -%}

  {%- if s.font_script_file != blank -%}
    @font-face {
      font-family: 'Battlemade';
      src: url('{{ s.font_script_file | asset_url }}') format('woff2');
      font-weight: 400;
      font-style: normal;
      font-display: swap;
    }
  {%- endif -%}
  {%- if s.font_serif_file != blank -%}
    @font-face {
      font-family: 'Begum';
      src: url('{{ s.font_serif_file | asset_url }}') format('woff2');
      font-weight: 500;
      font-style: normal;
      font-display: swap;
    }
  {%- endif -%}
  {%- if s.font_sans_file != blank -%}
    @font-face {
      font-family: 'Gotham';
      src: url('{{ s.font_sans_file | asset_url }}') format('woff2');
      font-weight: 400;
      font-style: normal;
      font-display: swap;
    }
  {%- endif -%}
  {%- if s.font_sans_medium_file != blank -%}
    @font-face {
      font-family: 'Gotham';
      src: url('{{ s.font_sans_medium_file | asset_url }}') format('woff2');
      font-weight: 500;
      font-style: normal;
      font-display: swap;
    }
  {%- endif -%}

  .wlg-{{ section.id }} {
    --wlg-bg: {{ s.background_color }};
    --wlg-container: {{ s.container_width }}px;
    --wlg-radius: {{ s.section_radius }}px;

    --wlg-pt: {{ s.padding_top }}px;
    --wlg-pb: {{ s.padding_bottom }}px;
    --wlg-pl: {{ s.padding_left }}px;
    --wlg-pr: {{ s.padding_right }}px;

    --wlg-pt-m: {{ s.padding_top_mobile }}px;
    --wlg-pb-m: {{ s.padding_bottom_mobile }}px;
    --wlg-px-m: {{ s.padding_side_mobile }}px;

    --wlg-col-gap: {{ s.column_gap }}px;
    --wlg-stack-gap-m: {{ s.stack_gap_mobile }}px;

    --wlg-img-h: {{ s.image_height }}px;
    --wlg-img-h-m: {{ s.image_height_mobile }}px;
    --wlg-img-fit: {{ s.image_fit }};
    --wlg-img-pos: {{ s.image_position }};
    --wlg-img-radius: {{ s.image_radius }}px;
    --wlg-img-radius-m: {{ s.image_radius_mobile }}px;

    --wlg-script: {{ s.font_script_stack }};
    --wlg-serif: {{ s.font_serif_stack }};
    --wlg-sans: {{ s.font_sans_stack }}, {{ body_font.family }}, {{ body_font.fallback_families }};

    --wlg-eyebrow-color: {{ s.eyebrow_color }};
    --wlg-title-color: {{ s.title_color }};
    --wlg-feature-title-color: {{ s.feature_title_color }};
    --wlg-feature-desc-color: {{ s.feature_desc_color }};

    --wlg-icon-size: {{ s.icon_size }}px;
    --wlg-icon-size-m: {{ s.icon_size_mobile }}px;
    --wlg-icon-gap: {{ s.icon_gap }}px;
    --wlg-icon-color: {{ s.icon_color }};

    --wlg-btn-bg: {{ s.button_background }};
    --wlg-btn-bg-hover: {{ s.button_background_hover }};
    --wlg-btn-color: {{ s.button_text_color }};
    --wlg-btn-radius: {{ s.button_radius }}px;
    --wlg-btn-px: {{ s.button_padding_x }}px;
    --wlg-btn-py: {{ s.button_padding_y }}px;
    --wlg-btn-min: {{ s.button_min_width }}px;

    --wlg-zoom: {{ s.image_zoom | divided_by: 100.0 }};
    --wlg-lift: -{{ s.button_lift }}px;
    --wlg-speed: {{ s.hover_speed }}ms;

    background-color: var(--wlg-bg);
    border-radius: var(--wlg-radius);
  }

  .wlg-{{ section.id }} *,
  .wlg-{{ section.id }} *::before,
  .wlg-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  .wlg-{{ section.id }} .wlg__container {
    max-width: var(--wlg-container);
    margin-inline: auto;
    padding: var(--wlg-pt) var(--wlg-pr) var(--wlg-pb) var(--wlg-pl);
  }

  .wlg-{{ section.id }} .wlg__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: {{ s.vertical_alignment }};
  }

  /* ----------------------------------------------------------- Media --- */
  .wlg-{{ section.id }} .wlg__media {
    position: relative;
    overflow: hidden;
    border-radius: var(--wlg-img-radius);
    background-color: rgba(25, 3, 3, 0.04);
  }

  .wlg-{{ section.id }} .wlg__media img,
  .wlg-{{ section.id }} .wlg__media svg {
    display: block;
    width: 100%;
    height: var(--wlg-img-h);
    object-fit: var(--wlg-img-fit);
    object-position: var(--wlg-img-pos);
    transition: transform var(--wlg-speed) cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  @media (hover: hover) {
    .wlg-{{ section.id }}.wlg--hover .wlg__media:hover img {
      transform: scale(var(--wlg-zoom));
    }
  }

  /* --------------------------------------------------------- Content --- */
  .wlg-{{ section.id }} .wlg__content {
    padding-left: var(--wlg-col-gap);
    text-align: left;
  }

  .wlg-{{ section.id }} .wlg__eyebrow {
    margin: 0 0 {{ s.heading_gap }}px 0;
    font-family: var(--wlg-script);
    font-weight: 400;
    font-size: {{ s.eyebrow_size }}px;
    line-height: {{ s.eyebrow_line_height }}px;
    letter-spacing: {{ s.eyebrow_letter_spacing }}px;
    color: var(--wlg-eyebrow-color);
  }

  .wlg-{{ section.id }} .wlg__title {
    margin: 0 0 {{ s.heading_space_below }}px 0;
    font-family: var(--wlg-serif);
    font-weight: 500;
    font-size: {{ s.title_size }}px;
    line-height: {{ s.title_line_height }}px;
    letter-spacing: {{ s.title_letter_spacing }}px;
    color: var(--wlg-title-color);
    text-transform: uppercase;
  }

  /* -------------------------------------------------------- Features --- */
  .wlg-{{ section.id }} .wlg__features {
    display: flex;
    flex-direction: column;
    gap: {{ s.feature_gap }}px;
  }

  .wlg-{{ section.id }} .wlg-feature__head {
    display: flex;
    align-items: center;
    gap: var(--wlg-icon-gap);
    margin-bottom: {{ s.feature_desc_gap }}px;
  }

  .wlg-{{ section.id }} .wlg-feature__icon {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--wlg-icon-size);
    height: var(--wlg-icon-size);
    color: var(--wlg-icon-color);
  }

  .wlg-{{ section.id }} .wlg-feature__icon > svg,
  .wlg-{{ section.id }} .wlg-feature__icon > img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .wlg-{{ section.id }} .wlg-feature__title {
    margin: 0;
    font-family: var(--wlg-sans);
    font-weight: 500;
    font-size: {{ s.feature_title_size }}px;
    line-height: {{ s.feature_title_line_height }}px;
    letter-spacing: {{ s.feature_title_letter_spacing }}em;
    color: var(--wlg-feature-title-color);
  }

  .wlg-{{ section.id }} .wlg-feature__desc {
    max-width: {{ s.feature_desc_max_width }}px;
    font-family: var(--wlg-sans);
    font-weight: 400;
    font-size: {{ s.feature_desc_size }}px;
    line-height: {{ s.feature_desc_line_height }}%;
    color: var(--wlg-feature-desc-color);
  }

  .wlg-{{ section.id }} .wlg-feature__desc > p {
    margin: 0;
  }

  .wlg-{{ section.id }} .wlg-feature__desc > p + p {
    margin-top: 0.6em;
  }

  .wlg-{{ section.id }} .wlg-feature__desc a {
    color: inherit;
    text-underline-offset: 3px;
  }

  /* ---------------------------------------------------------- Button --- */
  .wlg-{{ section.id }} .wlg__actions {
    margin-top: {{ s.button_margin_top }}px;
    text-align: {{ s.button_alignment }};
  }

  .wlg-{{ section.id }} .wlg__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: var(--wlg-btn-min);
    {%- if s.button_height > 0 -%}
      height: {{ s.button_height }}px;
    {%- endif -%}
    padding: var(--wlg-btn-py) var(--wlg-btn-px);
    border: 0;
    border-radius: var(--wlg-btn-radius);
    background-color: var(--wlg-btn-bg);
    color: var(--wlg-btn-color);
    font-family: var(--wlg-sans);
    font-weight: 600;
    font-size: {{ s.button_font_size }}px;
    line-height: {{ s.button_line_height }};
    letter-spacing: {{ s.button_letter_spacing }}em;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
    transition: background-color 300ms ease, transform 300ms ease, box-shadow 300ms ease;
  }

  @media (hover: hover) {
    .wlg-{{ section.id }}.wlg--hover .wlg__button:hover {
      background-color: var(--wlg-btn-bg-hover);
      transform: translateY(var(--wlg-lift));
      box-shadow: 0 10px 24px rgba(25, 3, 3, 0.18);
    }
  }

  .wlg-{{ section.id }} .wlg__button:focus-visible,
  .wlg-{{ section.id }} .wlg__media a:focus-visible {
    outline: 2px solid var(--wlg-title-color);
    outline-offset: 3px;
  }

  /* ------------------------------------------------------- Animation --- */
  .wlg-{{ section.id }}.wlg--animate .wlg-reveal {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 750ms cubic-bezier(0.22, 0.61, 0.36, 1),
      transform 750ms cubic-bezier(0.22, 0.61, 0.36, 1);
    transition-delay: var(--wlg-delay, 0ms);
  }

  .wlg-{{ section.id }}.wlg--animate .wlg-reveal--fade {
    transform: none;
  }

  .wlg-{{ section.id }}.wlg--animate .wlg-reveal.wlg-revealed {
    opacity: 1;
    transform: translateY(0);
  }

  /* =========================================================== TABLET === */
  @media screen and (max-width: 989px) {
    .wlg-{{ section.id }} .wlg__eyebrow {
      font-size: {{ s.eyebrow_size_tablet }}px;
    }

    .wlg-{{ section.id }} .wlg__title {
      font-size: {{ s.title_size_tablet }}px;
    }

    .wlg-{{ section.id }} .wlg-feature__title {
      font-size: {{ s.feature_title_size_tablet }}px;
    }

    .wlg-{{ section.id }} .wlg-feature__desc {
      font-size: {{ s.feature_desc_size_tablet }}px;
    }
  }

  /* =========================================================== MOBILE === */
  @media screen and (max-width: 749px) {
    .wlg-{{ section.id }} .wlg__container {
      padding: var(--wlg-pt-m) var(--wlg-px-m) var(--wlg-pb-m);
    }

    .wlg-{{ section.id }} .wlg__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--wlg-stack-gap-m);
    }

    .wlg-{{ section.id }} .wlg__media {
      border-radius: var(--wlg-img-radius-m);
    }

    .wlg-{{ section.id }} .wlg__media img,
    .wlg-{{ section.id }} .wlg__media svg {
      height: var(--wlg-img-h-m);
    }

    .wlg-{{ section.id }} .wlg__content {
      padding-left: 0;
      text-align: {{ s.mobile_text_alignment }};
    }

    .wlg-{{ section.id }} .wlg__eyebrow {
      font-size: {{ s.eyebrow_size_mobile }}px;
      line-height: {{ s.eyebrow_line_height_mobile }}px;
      letter-spacing: {{ s.eyebrow_letter_spacing_mobile }}px;
    }

    .wlg-{{ section.id }} .wlg__title {
      font-size: {{ s.title_size_mobile }}px;
      line-height: {{ s.title_line_height_mobile }}px;
      margin-bottom: {{ s.heading_space_below_mobile }}px;
    }

    .wlg-{{ section.id }} .wlg__features {
      gap: {{ s.feature_gap_mobile }}px;
    }

    .wlg-{{ section.id }} .wlg-feature__head {
      {%- if s.mobile_text_alignment == 'center' -%}
        justify-content: center;
      {%- endif -%}
    }

    .wlg-{{ section.id }} .wlg-feature__icon {
      width: var(--wlg-icon-size-m);
      height: var(--wlg-icon-size-m);
    }

    .wlg-{{ section.id }} .wlg-feature__title {
      font-size: {{ s.feature_title_size_mobile }}px;
    }

    .wlg-{{ section.id }} .wlg-feature__desc {
      max-width: none;
      margin-inline: {% if s.mobile_text_alignment == 'center' %}auto{% else %}0{% endif %};
      font-size: {{ s.feature_desc_size_mobile }}px;
      line-height: {{ s.feature_desc_line_height_mobile }}%;
    }

    .wlg-{{ section.id }} .wlg__actions {
      margin-top: {{ s.button_margin_top_mobile }}px;
      text-align: {{ s.mobile_text_alignment }};
    }

    .wlg-{{ section.id }} .wlg__button {
      font-size: {{ s.button_font_size_mobile }}px;
      {%- if s.button_full_width_mobile -%}
        display: flex;
        width: 100%;
        max-width: {{ s.button_max_width_mobile }}px;
        margin-inline: {% if s.mobile_text_alignment == 'center' %}auto{% else %}0{% endif %};
      {%- endif -%}
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wlg-{{ section.id }}.wlg--animate .wlg-reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }

    .wlg-{{ section.id }} .wlg__media img,
    .wlg-{{ section.id }} .wlg__button {
      transition: none;
    }
  }
</style>

<noscript>
  <style>
    #shopify-section-{{ section.id }} .wlg-reveal {
      opacity: 1;
      transform: none;
    }
  </style>
</noscript>

<div id="WLG-{{ section.id }}" class="{{ root_classes }}">
  <div class="wlg__container">
    <div class="wlg__grid">
      <div class="wlg__media wlg-reveal wlg-reveal--fade">
        {%- if s.image != blank -%}
          {{
            s.image
            | image_url: width: 1400
            | image_tag:
              loading: 'lazy',
              widths: '360,540,650,720,900,1080,1300,1400',
              sizes: sizes_attr,
              alt: image_alt,
              class: 'wlg__image'
          }}
        {%- else -%}
          {{ 'image' | placeholder_svg_tag: 'wlg__image' }}
        {%- endif -%}
      </div>

      <div class="wlg__content">
        {%- if s.eyebrow != blank -%}
          <p class="wlg__eyebrow wlg-reveal">{{ s.eyebrow | escape }}</p>
        {%- endif -%}

        {%- if s.heading != blank -%}
          <h2 class="wlg__title wlg-reveal" style="--wlg-delay: 80ms;">{{ s.heading | escape }}</h2>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <div class="wlg__features">
            {%- for block in section.blocks -%}
              {%- liquid
                assign delay = forloop.index0 | times: s.animation_stagger | plus: 160
                assign icon_stroke = s.icon_stroke
              -%}
              <div class="wlg-feature wlg-reveal" style="--wlg-delay: {{ delay }}ms;" {{ block.shopify_attributes }}>
                <div class="wlg-feature__head">
                  {%- if block.settings.icon_style != 'none' -%}
                    <span class="wlg-feature__icon" aria-hidden="true">
                      {%- case block.settings.icon_style -%}
                        {%- when 'flower' -%}
                          <svg viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg" fill="none" stroke="currentColor" stroke-width="{{ icon_stroke }}" stroke-linecap="round" stroke-linejoin="round">
                            <g transform="translate(20 20)">
                              <ellipse cx="0" cy="-7.6" rx="4.6" ry="7.2" />
                              <ellipse cx="0" cy="-7.6" rx="4.6" ry="7.2" transform="rotate(72)" />
                              <ellipse cx="0" cy="-7.6" rx="4.6" ry="7.2" transform="rotate(144)" />
                              <ellipse cx="0" cy="-7.6" rx="4.6" ry="7.2" transform="rotate(216)" />
                              <ellipse cx="0" cy="-7.6" rx="4.6" ry="7.2" transform="rotate(288)" />
                              <circle cx="0" cy="0" r="2.4" />
                            </g>
                          </svg>
                        {%- when 'leaf' -%}
                          <svg viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg" fill="none" stroke="currentColor" stroke-width="{{ icon_stroke }}" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M30 9.5c0 11.2-7.5 19.4-18.6 21.2C9.1 19.1 17 10.6 30 9.5Z" />
                            <path d="M11.4 30.7 24.6 16" />
                          </svg>
                        {%- when 'gem' -%}
                          <svg viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg" fill="none" stroke="currentColor" stroke-width="{{ icon_stroke }}" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M8.5 11.5h23v6.2c0 6.4-4.6 11.6-11.5 14.3C13.1 29.3 8.5 24.1 8.5 17.7Z" />
                            <path d="M14.2 16.4c0 3.6 2.3 6.4 5.8 7.6" />
                          </svg>
                        {%- when 'custom' -%}
                          {{ block.settings.icon_svg }}
                        {%- when 'image' -%}
                          {%- if block.settings.icon_image != blank -%}
                            {{
                              block.settings.icon_image
                              | image_url: width: 160
                              | image_tag: loading: 'lazy', widths: '40,80,120,160', alt: ''
                            }}
                          {%- endif -%}
                      {%- endcase -%}
                    </span>
                  {%- endif -%}

                  {%- if block.settings.title != blank -%}
                    <h3 class="wlg-feature__title">{{ block.settings.title | escape }}</h3>
                  {%- endif -%}
                </div>

                {%- if block.settings.description != blank -%}
                  <div class="wlg-feature__desc">{{ block.settings.description }}</div>
                {%- endif -%}
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if s.button_text != blank -%}
          <div class="wlg__actions wlg-reveal" style="--wlg-delay: {{ section.blocks.size | times: s.animation_stagger | plus: 220 }}ms;">
            <a
              class="wlg__button"
              {% if s.button_link != blank %}
                href="{{ s.button_link }}"
              {% else %}
                href="#" role="link" aria-disabled="true"
              {% endif %}
              {% if s.button_new_tab %}
                target="_blank" rel="noopener noreferrer"
              {% endif %}
            >
              {{- s.button_text | escape -}}
            </a>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{%- if s.enable_animation -%}
  <script>
    (function () {
      var SECTION_ID = {{ section.id | json }};

      function initWhyLabGrown() {
        var root = document.getElementById('WLG-' + SECTION_ID);
        if (!root) return;

        var items = root.querySelectorAll('.wlg-reveal');
        if (!items.length) return;

        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        if (reduce || !('IntersectionObserver' in window)) {
          for (var i = 0; i < items.length; i++) items[i].classList.add('wlg-revealed');
          return;
        }

        var observer = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('wlg-revealed');
              observer.unobserve(entry.target);
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 }
        );

        for (var j = 0; j < items.length; j++) observer.observe(items[j]);
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initWhyLabGrown);
      } else {
        initWhyLabGrown();
      }

      document.addEventListener('shopify:section:load', function (event) {
        if (event.detail && event.detail.sectionId === SECTION_ID) initWhyLabGrown();
      });
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Why lab grown",
  "tag": "section",
  "class": "why-lab-grown-section",
  "max_blocks": 12,
  "settings": [
    { "type": "header", "content": "Layout" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#F9E2D2" },
    {
      "type": "range",
      "id": "container_width",
      "min": 1000,
      "max": 1920,
      "step": 10,
      "unit": "px",
      "label": "Container width",
      "default": 1440
    },
    {
      "type": "range",
      "id": "column_gap",
      "min": 0,
      "max": 140,
      "step": 2,
      "unit": "px",
      "label": "Column gap",
      "info": "Applied as inner padding on the content column so the image stays a true 50%.",
      "default": 56
    },
    {
      "type": "select",
      "id": "vertical_alignment",
      "label": "Vertical alignment",
      "options": [
        { "value": "center", "label": "Center" },
