        <svg class="icon icon-cart" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M3 4.2h1.3a1.2 1.2 0 0 1 1.2 1.2v9.1a1.9 1.9 0 0 0 1.9 1.9h9.3a1.9 1.9 0 0 0 1.9-1.9V8.5a1.2 1.2 0 0 0-1.2-1.2H5.5"></path>
          <path d="M10.4 11.6a2.6 2.6 0 0 0 4.2 0"></path>
          <circle cx="9.6" cy="19.6" r="1.1"></circle>
          <circle cx="16.4" cy="19.6" r="1.1"></circle>
