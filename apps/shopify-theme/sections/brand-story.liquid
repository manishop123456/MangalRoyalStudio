    {
      "type": "range",
      "id": "main_heading_size_tablet",
      "min": 40,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Tablet Font Size",
      "default": 96
    },
    {
      "type": "range",
      "id": "main_heading_size_mobile",
      "min": 30,
      "max": 80,
      "step": 2,
