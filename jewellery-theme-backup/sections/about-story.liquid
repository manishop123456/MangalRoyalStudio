{% liquid
  assign section_id = 'visionaries-' | append: section.id
%}

<style>
  {{ section_id | prepend: '#' }} {
    --desktop-bg: {{ section.settings.desktop_bg }};
    --desktop-text: {{ section.settings.desktop_text }};
    --desktop-accent: {{ section.settings.desktop_accent }};
    --mobile-bg: {{ section.settings.mobile_bg }};
    --mobile-text: {{ section.settings.mobile_text }};
    --mobile-accent: {{ section.settings.mobile_accent }};
  }

  {{ section_id | prepend: '#' }} * {
    box-sizing: border-box;
  }

  {{ section_id | prepend: '#' }} {
    width: 100%;
    background: var(--desktop-bg);
    color: var(--desktop-text);
    overflow: hidden;
    padding-top: {{ section.settings.desktop_padding_top }}px;
    padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
    padding-left: {{ section.settings.desktop_padding_left }}px;
    padding-right: {{ section.settings.desktop_padding_right }}px;
  }

  {{ section_id | prepend: '#' }} .visionaries-heading {
    text-align: {{ section.settings.heading_alignment }};
    margin: 0 0 {{ section.settings.heading_bottom_spacing }}px;
    padding: 0 {{ section.settings.desktop_content_padding_x }}px;
  }

  {{ section_id | prepend: '#' }} .visionaries-heading h2 {
    margin: 0;
    font-family: Georgia, "Times New Roman", serif;
    font-size: {{ section.settings.desktop_heading_size }}px;
    line-height: 1.15;
    font-weight: 400;
    letter-spacing: {{ section.settings.desktop_heading_letter_spacing }}px;
    color: var(--desktop-text);
  }

  {{ section_id | prepend: '#' }} .visionaries-list {
    width: 100%;
  }

  {{ section_id | prepend: '#' }} .visionary-item {
    width: 100%;
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: {{ section.settings.desktop_image_height }}px;
  }

  {{ section_id | prepend: '#' }} .visionary-item + .visionary-item {
    margin-top: {{ section.settings.desktop_row_gap }}px;
  }

  {{ section_id | prepend: '#' }} .visionary-image {
    width: 100%;
    height: {{ section.settings.desktop_image_height }}px;
    overflow: hidden;
    background: {{ section.settings.image_placeholder_color }};
    border-radius: {{ section.settings.desktop_image_radius }}px;
  }

  {{ section_id | prepend: '#' }} .visionary-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
  }

  {{ section_id | prepend: '#' }} .visionary-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #514b48;
    font-family: Arial, sans-serif;
    font-size: 16px;
    letter-spacing: 0.02em;
  }

  {{ section_id | prepend: '#' }} .visionary-content {
    min-height: {{ section.settings.desktop_image_height }}px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-top: {{ section.settings.desktop_content_padding_y }}px;
    padding-bottom: {{ section.settings.desktop_content_padding_y }}px;
    padding-left: {{ section.settings.desktop_content_padding_x }}px;
    padding-right: {{ section.settings.desktop_content_padding_x }}px;
  }

  {{ section_id | prepend: '#' }} .visionary-name {
    margin: 0;
    font-family: Georgia, "Times New Roman", serif;
    font-size: {{ section.settings.desktop_name_size }}px;
    line-height: 1.12;
    font-weight: 400;
    color: var(--desktop-text);
    letter-spacing: {{ section.settings.desktop_name_letter_spacing }}px;
  }

  {{ section_id | prepend: '#' }} .visionary-role {
    margin-top: 5px;
    font-family: Arial, Helvetica, sans-serif;
    font-size: {{ section.settings.desktop_role_size }}px;
    line-height: 1.35;
    font-weight: 400;
    color: var(--desktop-text);
    opacity: 0.95;
    letter-spacing: {{ section.settings.desktop_role_letter_spacing }}px;
  }

  {{ section_id | prepend: '#' }} .visionary-description {
    margin: {{ section.settings.desktop_description_spacing }}px 0 0;
    max-width: {{ section.settings.desktop_description_width }}%;
    font-family: Arial, Helvetica, sans-serif;
    font-size: {{ section.settings.desktop_description_size }}px;
    line-height: {{ section.settings.desktop_description_line_height }};
    font-weight: 400;
    color: var(--desktop-text);
    letter-spacing: {{ section.settings.desktop_description_letter_spacing }}px;
  }

  {{ section_id | prepend: '#' }} .visionary-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0;
    margin-top: {{ section.settings.desktop_meta_spacing }}px;
    font-family: Arial, Helvetica, sans-serif;
    font-size: {{ section.settings.desktop_meta_size }}px;
    line-height: 1.4;
    font-weight: 500;
    color: var(--desktop-accent);
    text-transform: uppercase;
    letter-spacing: {{ section.settings.desktop_meta_letter_spacing }}px;
  }

  {{ section_id | prepend: '#' }} .visionary-meta span {
    display: inline-flex;
    align-items: center;
  }

  {{ section_id | prepend: '#' }} .visionary-meta span:not(:last-child)::after {
    content: "•";
    margin: 0 12px;
    color: var(--desktop-accent);
  }

  {{ section_id | prepend: '#' }} .visionary-item.image-left .visionary-image {
    grid-column: 1;
    grid-row: 1;
  }

  {{ section_id | prepend: '#' }} .visionary-item.image-left .visionary-content {
    grid-column: 2;
    grid-row: 1;
  }

  {{ section_id | prepend: '#' }} .visionary-item.image-right .visionary-content {
    grid-column: 1;
    grid-row: 1;
  }

  {{ section_id | prepend: '#' }} .visionary-item.image-right .visionary-image {
    grid-column: 2;
    grid-row: 1;
  }

  {{ section_id | prepend: '#' }} .mobile-carousel-controls {
    display: none;
  }

  @media screen and (max-width: 749px) {
    {{ section_id | prepend: '#' }} {
      background: var(--mobile-bg);
      color: var(--mobile-text);
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
      padding-left: {{ section.settings.mobile_padding_left }}px;
      padding-right: {{ section.settings.mobile_padding_right }}px;
    }

    {{ section_id | prepend: '#' }} .visionaries-heading {
      padding: 0 {{ section.settings.mobile_content_padding_x }}px;
      margin-bottom: {{ section.settings.mobile_heading_bottom_spacing }}px;
    }

    {{ section_id | prepend: '#' }} .visionaries-heading h2 {
      font-size: {{ section.settings.mobile_heading_size }}px;
      line-height: 1.2;
      letter-spacing: {{ section.settings.mobile_heading_letter_spacing }}px;
    }

    {{ section_id | prepend: '#' }} .visionaries-list {
      position: relative;
      width: 100%;
      overflow: hidden;
    }

    {{ section_id | prepend: '#' }} .visionary-item {
      display: none;
      width: 100%;
      min-height: auto;
    }

    {{ section_id | prepend: '#' }} .visionary-item.is-active {
      display: flex;
      flex-direction: column;
    }

    {{ section_id | prepend: '#' }} .visionary-item + .visionary-item {
      margin-top: 0;
    }

    {{ section_id | prepend: '#' }} .visionary-image,
    {{ section_id | prepend: '#' }} .visionary-item.image-left .visionary-image,
    {{ section_id | prepend: '#' }} .visionary-item.image-right .visionary-image {
      order: 1;
      grid-column: auto;
      grid-row: auto;
      width: 100%;
      height: {{ section.settings.mobile_image_height }}px;
      min-height: {{ section.settings.mobile_image_height }}px;
      border-radius: {{ section.settings.mobile_image_radius }}px;
    }

    {{ section_id | prepend: '#' }} .visionary-content,
    {{ section_id | prepend: '#' }} .visionary-item.image-left .visionary-content,
    {{ section_id | prepend: '#' }} .visionary-item.image-right .visionary-content {
      order: 2;
      grid-column: auto;
      grid-row: auto;
      width: 100%;
      min-height: auto;
      padding-top: {{ section.settings.mobile_content_padding_y }}px;
      padding-bottom: {{ section.settings.mobile_content_padding_y }}px;
      padding-left: {{ section.settings.mobile_content_padding_x }}px;
      padding-right: {{ section.settings.mobile_content_padding_x }}px;
    }

    {{ section_id | prepend: '#' }} .visionary-name {
      font-size: {{ section.settings.mobile_name_size }}px;
      line-height: 1.15;
      letter-spacing: {{ section.settings.mobile_name_letter_spacing }}px;
    }

    {{ section_id | prepend: '#' }} .visionary-role {
      margin-top: 5px;
      font-size: {{ section.settings.mobile_role_size }}px;
      line-height: 1.35;
      letter-spacing: {{ section.settings.mobile_role_letter_spacing }}px;
    }

    {{ section_id | prepend: '#' }} .visionary-description {
      max-width: 100%;
      margin-top: {{ section.settings.mobile_description_spacing }}px;
      font-size: {{ section.settings.mobile_description_size }}px;
      line-height: {{ section.settings.mobile_description_line_height }};
      letter-spacing: {{ section.settings.mobile_description_letter_spacing }}px;
    }

    {{ section_id | prepend: '#' }} .visionary-meta {
      margin-top: {{ section.settings.mobile_meta_spacing }}px;
      font-size: {{ section.settings.mobile_meta_size }}px;
      line-height: 1.45;
      letter-spacing: {{ section.settings.mobile_meta_letter_spacing }}px;
    }

    {{ section_id | prepend: '#' }} .visionary-meta span:not(:last-child)::after {
      margin-left: 8px;
      margin-right: 8px;
    }

    {{ section_id | prepend: '#' }} .mobile-carousel-controls {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
      margin-top: {{ section.settings.mobile_controls_spacing }}px;
      padding: 0 {{ section.settings.mobile_content_padding_x }}px;
    }

    {{ section_id | prepend: '#' }} .mobile-arrow {
      width: {{ section.settings.mobile_arrow_size }}px;
      height: {{ section.settings.mobile_arrow_size }}px;
      flex: 0 0 {{ section.settings.mobile_arrow_size }}px;
      border: {{ section.settings.mobile_arrow_border_width }}px solid var(--mobile-text);
      background: transparent;
      color: var(--mobile-text);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      padding: 0;
      transition: all 0.25s ease;
    }

    {{ section_id | prepend: '#' }} .mobile-arrow:hover {
      background: var(--mobile-text);
      color: var(--mobile-bg);
    }

    {{ section_id | prepend: '#' }} .mobile-arrow svg {
      width: 15px;
      height: 15px;
    }

    {{ section_id | prepend: '#' }} .mobile-dots {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 7px;
    }

    {{ section_id | prepend: '#' }} .mobile-dot {
      width: {{ section.settings.mobile_selector_size }}px;
      height: {{ section.settings.mobile_selector_size }}px;
      border: {{ section.settings.mobile_selector_border_width }}px solid var(--mobile-text);
      border-radius: {{ section.settings.mobile_selector_radius }}px;
      background: transparent;
      padding: 0;
      cursor: pointer;
      opacity: 0.5;
      transition: all 0.25s ease;
    }

    {{ section_id | prepend: '#' }} .mobile-dot.is-active {
      opacity: 1;
      background: var(--mobile-text);
    }
  }

  @media screen and (min-width: 750px) {
    {{ section_id | prepend: '#' }} .visionary-content {
      background: transparent;
    }
  }
</style>

<section
  id="{{ section_id }}"
  class="visionaries-section"
  data-section-id="{{ section.id }}"
>
  {% if section.settings.heading != blank %}
    <div class="visionaries-heading">
      <h2>{{ section.settings.heading }}</h2>
    </div>
  {% endif %}

  <div class="visionaries-list">
    {% for block in section.blocks %}
      {% assign image_position = block.settings.image_position %}

      <article
        class="visionary-item {% if image_position == 'right' %}image-right{% else %}image-left{% endif %} {% if forloop.first %}is-active{% endif %}"
        data-slide="{{ forloop.index0 }}"
        {{ block.shopify_attributes }}
      >
        <div class="visionary-image">
          {% if block.settings.image != blank %}
            {{
              block.settings.image
              | image_url: width: 1800
              | image_tag:
                loading: 'lazy',
                widths: '550, 750, 1000, 1200, 1500, 1800',
                sizes: '(min-width: 750px) 50vw, 100vw',
                alt: block.settings.image_alt
            }}
          {% else %}
            <div class="visionary-placeholder">
              Add profile image
            </div>
          {% endif %}
        </div>

        <div class="visionary-content">
          {% if block.settings.name != blank %}
            <h3 class="visionary-name">
              {{ block.settings.name }}
            </h3>
          {% endif %}

          {% if block.settings.role != blank %}
            <div class="visionary-role">
              {{ block.settings.role }}
            </div>
          {% endif %}

          {% if block.settings.description != blank %}
            <div class="visionary-description">
              {{ block.settings.description }}
            </div>
          {% endif %}

          {% if block.settings.meta_1 != blank or block.settings.meta_2 != blank or block.settings.meta_3 != blank %}
            <div class="visionary-meta">
              {% if block.settings.meta_1 != blank %}
                <span>{{ block.settings.meta_1 }}</span>
              {% endif %}

              {% if block.settings.meta_2 != blank %}
                <span>{{ block.settings.meta_2 }}</span>
              {% endif %}

              {% if block.settings.meta_3 != blank %}
                <span>{{ block.settings.meta_3 }}</span>
              {% endif %}
            </div>
          {% endif %}
        </div>
      </article>
    {% endfor %}
  </div>

  {% if section.blocks.size > 1 %}
    <div class="mobile-carousel-controls">
      <button
        type="button"
        class="mobile-arrow mobile-prev"
        aria-label="Previous visionary"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M15 18l-6-6 6-6"></path>
        </svg>
      </button>

      <div class="mobile-dots">
        {% for block in section.blocks %}
          <button
            type="button"
            class="mobile-dot {% if forloop.first %}is-active{% endif %}"
            data-slide-to="{{ forloop.index0 }}"
            aria-label="Go to visionary {{ forloop.index }}"
          ></button>
        {% endfor %}
      </div>

      <button
        type="button"
        class="mobile-arrow mobile-next"
        aria-label="Next visionary"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M9 18l6-6-6-6"></path>
        </svg>
      </button>
    </div>
  {% endif %}
</section>

<script>
  (function() {
    function initVisionaries(section) {
      if (!section) return;

      const slides = Array.from(section.querySelectorAll('.visionary-item'));
      const dots = Array.from(section.querySelectorAll('.mobile-dot'));
      const prevButton = section.querySelector('.mobile-prev');
      const nextButton = section.querySelector('.mobile-next');

      if (!slides.length) return;

      let currentIndex = 0;
      let touchStartX = 0;
      let touchEndX = 0;

      function isMobile() {
        return window.innerWidth <= 749;
      }

      function showSlide(index) {
        if (!slides.length) return;

        currentIndex = (index + slides.length) % slides.length;

        if (!isMobile()) {
          slides.forEach(function(slide) {
            slide.classList.add('is-active');
          });
          return;
        }

        slides.forEach(function(slide, slideIndex) {
          slide.classList.toggle(
            'is-active',
            slideIndex === currentIndex
          );
        });

        dots.forEach(function(dot, dotIndex) {
          dot.classList.toggle(
            'is-active',
            dotIndex === currentIndex
          );
        });
      }

      function goNext() {
        showSlide(currentIndex + 1);
      }

      function goPrevious() {
        showSlide(currentIndex - 1);
      }

      if (nextButton) {
        nextButton.addEventListener('click', goNext);
      }

      if (prevButton) {
        prevButton.addEventListener('click', goPrevious);
      }

      dots.forEach(function(dot) {
        dot.addEventListener('click', function() {
          const index = parseInt(
            dot.getAttribute('data-slide-to'),
            10
          );

          showSlide(index);
        });
      });

      section.addEventListener(
        'touchstart',
        function(event) {
          if (!isMobile()) return;

          touchStartX = event.changedTouches[0].screenX;
        },
        { passive: true }
      );

      section.addEventListener(
        'touchend',
        function(event) {
          if (!isMobile()) return;

          touchEndX = event.changedTouches[0].screenX;

          const difference = touchStartX - touchEndX;

          if (Math.abs(difference) < 45) return;

          if (difference > 0) {
            goNext();
          } else {
            goPrevious();
          }
        },
        { passive: true }
      );

      window.addEventListener('resize', function() {
        if (!isMobile()) {
          slides.forEach(function(slide) {
            slide.classList.add('is-active');
          });
        } else {
          showSlide(currentIndex);
        }
      });

      showSlide(0);
    }

    const section = document.getElementById('{{ section_id }}');

    if (section) {
      initVisionaries(section);
    }

    document.addEventListener('shopify:section:load', function(event) {
      if (event.detail && event.detail.sectionId === '{{ section.id }}') {
        const loadedSection = document.getElementById('{{ section_id }}');

        if (loadedSection) {
          initVisionaries(loadedSection);
        }
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Visionaries Editorial",
  "tag": "section",
  "class": "visionaries-editorial-section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "THE VISIONARIES BEHIND MANGAL ROYAL STUDIO"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "heading_bottom_spacing",
      "label": "Heading bottom spacing",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 16
    },

    {
      "type": "header",
      "content": "Desktop colors"
    },
    {
      "type": "color",
      "id": "desktop_bg",
      "label": "Background",
      "default": "#F7DDCD"
    },
    {
      "type": "color",
      "id": "desktop_text",
      "label": "Text",
      "default": "#241B18"
    },
    {
      "type": "color",
      "id": "desktop_accent",
      "label": "Accent",
      "default": "#A72C36"
    },
    {
      "type": "color",
      "id": "image_placeholder_color",
      "label": "Image placeholder",
      "default": "#FAF2EC"
    },

    {
      "type": "header",
      "content": "Desktop spacing"
    },
    {
      "type": "range",
      "id": "desktop_padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "desktop_padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "desktop_padding_left",
      "label": "Left padding",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "desktop_padding_right",
      "label": "Right padding",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "desktop_content_padding_x",
      "label": "Content horizontal padding",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "desktop_content_padding_y",
      "label": "Content vertical padding",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "desktop_row_gap",
      "label": "Row gap",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0
    },

    {
      "type": "header",
      "content": "Desktop image"
    },
    {
      "type": "range",
      "id": "desktop_image_height",
      "label": "Image height",
      "min": 200,
      "max": 700,
      "step": 5,
      "unit": "px",
      "default": 460
    },
    {
      "type": "range",
      "id": "desktop_image_radius",
      "label": "Image corner radius",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 0
    },

    {
      "type": "header",
      "content": "Desktop typography"
    },
    {
      "type": "range",
      "id": "desktop_heading_size",
      "label": "Heading size",
      "min": 16,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "desktop_heading_letter_spacing",
      "label": "Heading letter spacing",
      "min": 0,
      "max": 3,
      "step": 0.5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "desktop_name_size",
      "label": "Name size",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "desktop_name_letter_spacing",
      "label": "Name letter spacing",
      "min": 0,
      "max": 2,
      "step": 0.5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "desktop_role_size",
      "label": "Role size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "desktop_role_letter_spacing",
      "label": "Role letter spacing",
      "min": 0,
      "max": 2,
      "step": 0.5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "desktop_description_size",
      "label": "Description size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 17
    },
    {
  "type": "range",
  "id": "desktop_description_line_height",
  "label": "Description line height",
  "min": 1.2,
  "max": 2.0,
  "step": 0.1,
  "default": 1.5
},
{
  "type": "range",
  "id": "desktop_description_letter_spacing",
