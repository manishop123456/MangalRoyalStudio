{% liquid
  assign section_id = 'brand-promise-' | append: section.id
%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Allura&family=Cormorant+Garamond:wght@400;500;600;700&family=DM+Sans:wght@400;500;600&family=Great+Vibes&family=Montserrat:wght@400;500;600&family=Parisienne&family=Playfair+Display:wght@400;500;600&display=swap');

  #{{ section_id }} {
    --bp-bg: {{ section.settings.desktop_bg }};
    --bp-text: {{ section.settings.desktop_text }};
    --bp-script: {{ section.settings.desktop_script_color }};
    --bp-button-bg: {{ section.settings.desktop_button_bg }};
    --bp-button-text: {{ section.settings.desktop_button_text }};
    --bp-image-border: {{ section.settings.desktop_image_border_color }};

    position: relative;
    isolation: isolate;
    z-index: 0;

    width: 100%;
    display: block;
    clear: both;

    background: {{ section.settings.outer_background }};

    padding-top: {{ section.settings.desktop_outer_top }}px;
    padding-bottom: {{ section.settings.desktop_outer_bottom }}px;

    margin: 0;
    overflow: hidden;
  }

  #{{ section_id }},
  #{{ section_id }} *,
  #{{ section_id }} *::before,
  #{{ section_id }} *::after {
    box-sizing: border-box;
  }

  #{{ section_id }} .bp-band {
    position: relative;
    width: 100%;
    min-height: {{ section.settings.desktop_band_height }}px;

    background: var(--bp-bg);
    border-radius: {{ section.settings.desktop_band_radius }}px;

    overflow: hidden;
    isolation: isolate;
  }

  /* =========================================================
     DESKTOP LAYOUT
     ========================================================= */

  #{{ section_id }} .bp-desktop-layout {
    position: relative;
    width: 100%;
    min-height: {{ section.settings.desktop_band_height }}px;

    display: grid;
    grid-template-columns: 54% 46%;
    align-items: stretch;

    overflow: hidden;
  }

  /* =========================================================
     DESKTOP COLLAGE
     ========================================================= */

  #{{ section_id }} .bp-desktop-collage {
    position: relative;

    width: {{ section.settings.desktop_collage_width }}px;
    height: {{ section.settings.desktop_collage_height }}px;

    margin-left: {{ section.settings.desktop_collage_left }}px;
    margin-top: {{ section.settings.desktop_collage_top }}px;

    overflow: visible;

    z-index: 2;
    align-self: start;
  }

  #{{ section_id }} .bp-desktop-image {
    position: absolute;

    overflow: hidden;

    background: #f5eee8;

    border:
      {{ section.settings.desktop_image_border_width }}px
      solid
      var(--bp-image-border);

    box-shadow:
      0 0
      {{ section.settings.desktop_image_shadow }}px
      rgba(0, 0, 0, 0.06);

    transition:
      transform 0.35s ease,
      box-shadow 0.35s ease;
  }

  #{{ section_id }} .bp-desktop-image:hover {
    transform: translateY(-3px);
  }

  #{{ section_id }} .bp-desktop-image img {
    display: block;

    width: 100%;
    height: 100%;

    object-fit: cover;
    object-position: center center;
  }

  /* =========================================================
     PLACEHOLDER
     ========================================================= */

  #{{ section_id }} .bp-placeholder {
    width: 100%;
    height: 100%;

    display: flex;
    align-items: center;
    justify-content: center;

    padding: 20px;

    text-align: center;

    color: #5b4b47;

    font-family: Arial, sans-serif;
    font-size: 14px;
  }

  /* =========================================================
     DESKTOP CONTENT
     ========================================================= */

  #{{ section_id }} .bp-content {
    position: relative;

    z-index: 3;

    display: flex;
    flex-direction: column;

    justify-content: {{ section.settings.desktop_content_vertical }};
    align-items: flex-start;

    padding-top: {{ section.settings.desktop_content_padding_y }}px;
    padding-bottom: {{ section.settings.desktop_content_padding_y }}px;

    padding-left: {{ section.settings.desktop_content_padding_left }}px;
    padding-right: {{ section.settings.desktop_content_padding_right }}px;
  }

  #{{ section_id }} .bp-content-inner {
    width: 100%;
    max-width: {{ section.settings.desktop_content_width }}%;
  }

  #{{ section_id }} .bp-heading {
    margin: 0;

    color: var(--bp-text);

    font-family:
      {{ section.settings.desktop_heading_font }},
      Georgia,
      serif;

    font-size: {{ section.settings.desktop_heading_size }}px;
    line-height: 1.05;

    font-weight: 500;

    letter-spacing:
      {{ section.settings.desktop_heading_letter_spacing }}px;

    text-transform: uppercase;
  }

  #{{ section_id }} .bp-script {
    margin-top:
      {{ section.settings.desktop_script_spacing }}px;

    margin-bottom: 0;

    color: var(--bp-script);

    font-family:
      {{ section.settings.desktop_script_font }},
      cursive;

    font-size: {{ section.settings.desktop_script_size }}px;
    line-height: 1;

    font-weight: 400;

    letter-spacing:
      {{ section.settings.desktop_script_letter_spacing }}px;
  }

  #{{ section_id }} .bp-description {
    margin:
      {{ section.settings.desktop_description_spacing }}px
      0
      0;

    color: var(--bp-text);

    font-family:
      {{ section.settings.desktop_body_font }},
      Arial,
      sans-serif;

    font-size: {{ section.settings.desktop_description_size }}px;

    line-height:
      {{ section.settings.desktop_description_line_height }};

    font-weight: 400;

    letter-spacing:
      {{ section.settings.desktop_description_letter_spacing }}px;
  }

  #{{ section_id }} .bp-button {
    display: inline-flex;

    align-items: center;
    justify-content: center;

    min-height:
      {{ section.settings.desktop_button_height }}px;

    margin-top:
      {{ section.settings.desktop_button_spacing }}px;

    padding-left:
      {{ section.settings.desktop_button_padding_x }}px;

    padding-right:
      {{ section.settings.desktop_button_padding_x }}px;

    background: var(--bp-button-bg);
    color: var(--bp-button-text);

    border:
      {{ section.settings.desktop_button_border_width }}px
      solid
      var(--bp-button-bg);

    text-decoration: none;

    font-family:
      {{ section.settings.desktop_body_font }},
      Arial,
      sans-serif;

    font-size:
      {{ section.settings.desktop_button_size }}px;

    line-height: 1;

    font-weight: 500;

    letter-spacing:
      {{ section.settings.desktop_button_letter_spacing }}px;

    text-transform: uppercase;

    transition:
      background 0.25s ease,
      color 0.25s ease,
      transform 0.25s ease;
  }

  #{{ section_id }} .bp-button:hover {
    background: transparent;
    color: var(--bp-button-bg);

    transform: translateY(-1px);
  }

  /* =========================================================
     MOBILE DEFAULT HIDDEN
     ========================================================= */

  #{{ section_id }} .bp-mobile-gallery,
  #{{ section_id }} .bp-mobile-controls,
  #{{ section_id }} .bp-mobile-content {
    display: none;
  }

  /* =========================================================
     MOBILE
     ========================================================= */

  @media screen and (max-width: 749px) {

    #{{ section_id }} {
      --bp-bg: {{ section.settings.mobile_bg }};
      --bp-text: {{ section.settings.mobile_text }};
      --bp-script: {{ section.settings.mobile_script_color }};
      --bp-button-bg: {{ section.settings.mobile_button_bg }};
      --bp-button-text: {{ section.settings.mobile_button_text }};
      --bp-image-border: {{ section.settings.mobile_image_border_color }};

      padding-top:
        {{ section.settings.mobile_outer_top }}px;

      padding-bottom:
        {{ section.settings.mobile_outer_bottom }}px;

      overflow: hidden;
    }

    #{{ section_id }} .bp-band {
      min-height: auto;

      border-radius:
        {{ section.settings.mobile_band_radius }}px;

      overflow: hidden;
    }

    #{{ section_id }} .bp-desktop-layout {
      display: none;
    }

    /* =======================================================
       MOBILE GRID
       ======================================================= */

    #{{ section_id }} .bp-mobile-gallery {
      position: relative;

      width: 100%;

      display: grid;

      grid-template-columns:
        repeat(2, minmax(0, 1fr));

      gap:
        {{ section.settings.mobile_grid_gap }}px;

      padding-top:
        {{ section.settings.mobile_grid_padding_top }}px;

      padding-left:
        {{ section.settings.mobile_grid_padding_x }}px;

      padding-right:
        {{ section.settings.mobile_grid_padding_x }}px;

      padding-bottom: 0;

      overflow: hidden;
    }

    #{{ section_id }} .bp-mobile-slide {
      display: block;

      width: 100%;
      min-width: 0;

      grid-column: auto;
    }

    #{{ section_id }} .bp-mobile-slide.is-active {
      display: block;
    }

    #{{ section_id }} .bp-mobile-image {
      position: relative;

      width: 100%;

      height:
        {{ section.settings.mobile_grid_image_height }}px;

      overflow: hidden;

      background: #f5eee8;

      border:
        {{ section.settings.mobile_image_border_width }}px
        solid
        var(--bp-image-border);

      border-radius:
        {{ section.settings.mobile_image_radius }}px;
    }

    #{{ section_id }} .bp-mobile-image img {
      display: block;

      width: 100%;
      height: 100%;

      object-fit: cover;
      object-position: center center;
    }

    /* Fifth image becomes full width */

    #{{ section_id }}
    .bp-mobile-slide:nth-child(5) {
      grid-column: 1 / -1;
    }

    #{{ section_id }}
    .bp-mobile-slide:nth-child(5)
    .bp-mobile-image {
      height:
        {{ section.settings.mobile_grid_last_image_height }}px;
    }

    /* =======================================================
       MOBILE CAROUSEL MODE
       ======================================================= */

    #{{ section_id }}[data-mobile-layout="carousel"]
    .bp-mobile-gallery {
      display: block;

      padding-left: 0;
      padding-right: 0;

      padding-top:
        {{ section.settings.mobile_grid_padding_top }}px;
    }

    #{{ section_id }}[data-mobile-layout="carousel"]
    .bp-mobile-slide {
      display: none;

      width: 100%;
    }

    #{{ section_id }}[data-mobile-layout="carousel"]
    .bp-mobile-slide.is-active {
      display: block;
    }

    #{{ section_id }}[data-mobile-layout="carousel"]
    .bp-mobile-image {
      width: 100%;

      height:
        {{ section.settings.mobile_carousel_image_height }}px;

      border-radius:
        {{ section.settings.mobile_image_radius }}px;
    }

    #{{ section_id }}[data-mobile-layout="carousel"]
    .bp-mobile-slide:nth-child(5)
    .bp-mobile-image {
      height:
        {{ section.settings.mobile_carousel_image_height }}px;
    }

    /* =======================================================
       MOBILE CONTROLS
       ======================================================= */

    #{{ section_id }} .bp-mobile-controls {
      display: none;
    }

    #{{ section_id }}[data-mobile-layout="carousel"]
    .bp-mobile-controls {
      display: flex;

      align-items: center;
      justify-content: center;

      gap:
        {{ section.settings.mobile_controls_gap }}px;

      width: 100%;

      padding-top:
        {{ section.settings.mobile_controls_top }}px;

      padding-bottom:
        {{ section.settings.mobile_controls_bottom }}px;

      padding-left:
        {{ section.settings.mobile_content_padding }}px;

      padding-right:
        {{ section.settings.mobile_content_padding }}px;
    }

    #{{ section_id }} .bp-arrow {
      width:
        {{ section.settings.mobile_arrow_size }}px;

      height:
        {{ section.settings.mobile_arrow_size }}px;

      flex: 0 0
        {{ section.settings.mobile_arrow_size }}px;

      display: flex;

      align-items: center;
      justify-content: center;

      padding: 0;

      border:
        {{ section.settings.mobile_arrow_border_width }}px
        solid
        var(--bp-text);

      border-radius: 50%;

      background: transparent;
      color: var(--bp-text);

      cursor: pointer;

      transition:
        background 0.25s ease,
        color 0.25s ease,
        transform 0.25s ease;
    }

    #{{ section_id }} .bp-arrow:hover {
      background: var(--bp-text);
      color: var(--bp-bg);

      transform: scale(1.04);
    }

    #{{ section_id }} .bp-arrow svg {
      width: 16px;
      height: 16px;
    }

    #{{ section_id }} .bp-dots {
      display: flex;

      align-items: center;
      justify-content: center;

      gap:
        {{ section.settings.mobile_dot_gap }}px;
    }

    #{{ section_id }} .bp-dot {
      width:
        {{ section.settings.mobile_dot_size }}px;

      height:
        {{ section.settings.mobile_dot_size }}px;

      flex: 0 0
        {{ section.settings.mobile_dot_size }}px;

      padding: 0;

      border:
        {{ section.settings.mobile_dot_border_width }}px
        solid
        var(--bp-text);

      border-radius: 50%;

      background: transparent;

      opacity: 0.4;

      cursor: pointer;

      transition:
        opacity 0.25s ease,
        background 0.25s ease,
        transform 0.25s ease;
    }

    #{{ section_id }} .bp-dot.is-active {
      opacity: 1;

      background: var(--bp-text);

      transform: scale(1.1);
    }

    /* =======================================================
       MOBILE CONTENT
       ======================================================= */

    #{{ section_id }} .bp-mobile-content {
      display: flex;

      flex-direction: column;

      align-items:
        {{ section.settings.mobile_content_alignment }};

      padding-top:
        {{ section.settings.mobile_content_padding_y }}px;

      padding-bottom:
        {{ section.settings.mobile_content_padding_y }}px;

      padding-left:
        {{ section.settings.mobile_content_padding }}px;

      padding-right:
        {{ section.settings.mobile_content_padding }}px;

      text-align:
        {{ section.settings.mobile_text_alignment }};
    }

    #{{ section_id }} .bp-mobile-content-inner {
      width: 100%;

      max-width:
        {{ section.settings.mobile_content_width }}%;
    }

    #{{ section_id }} .bp-heading {
      font-family:
        {{ section.settings.mobile_heading_font }},
        Georgia,
        serif;

      font-size:
        {{ section.settings.mobile_heading_size }}px;

      line-height: 1.05;

      letter-spacing:
        {{ section.settings.mobile_heading_letter_spacing }}px;
    }

    #{{ section_id }} .bp-script {
      margin-top:
        {{ section.settings.mobile_script_spacing }}px;

      font-family:
        {{ section.settings.mobile_script_font }},
        cursive;

      font-size:
        {{ section.settings.mobile_script_size }}px;

      line-height: 1;

      letter-spacing:
        {{ section.settings.mobile_script_letter_spacing }}px;
    }

    #{{ section_id }} .bp-description {
      margin-top:
        {{ section.settings.mobile_description_spacing }}px;

      font-family:
        {{ section.settings.mobile_body_font }},
        Arial,
        sans-serif;

      font-size:
        {{ section.settings.mobile_description_size }}px;

      line-height:
        {{ section.settings.mobile_description_line_height }};

      letter-spacing:
        {{ section.settings.mobile_description_letter_spacing }}px;
    }

    #{{ section_id }} .bp-button {
      min-height:
        {{ section.settings.mobile_button_height }}px;

      margin-top:
        {{ section.settings.mobile_button_spacing }}px;

      padding-left:
        {{ section.settings.mobile_button_padding_x }}px;

      padding-right:
        {{ section.settings.mobile_button_padding_x }}px;

      font-family:
        {{ section.settings.mobile_body_font }},
        Arial,
        sans-serif;

      font-size:
        {{ section.settings.mobile_button_size }}px;

      letter-spacing:
        {{ section.settings.mobile_button_letter_spacing }}px;
    }
  }

  /* =========================================================
     TABLET
     ========================================================= */

  @media screen and (min-width: 750px) and (max-width: 1100px) {

    #{{ section_id }} .bp-desktop-layout {
      grid-template-columns: 52% 48%;
    }

    #{{ section_id }} .bp-desktop-collage {
      transform: scale(0.82);
      transform-origin: left top;
    }

    #{{ section_id }} .bp-content {
      padding-left: 30px;
      padding-right: 30px;
    }

    #{{ section_id }} .bp-heading {
      font-size: 28px;
    }

    #{{ section_id }} .bp-script {
      font-size: 36px;
    }

    #{{ section_id }} .bp-description {
      font-size: 14px;
    }
  }
</style>

<section
  id="{{ section_id }}"
  class="brand-promise-section"
  data-section-id="{{ section.id }}"
  data-mobile-layout="{{ section.settings.mobile_layout }}"
>

  <div class="bp-band">

    <!-- =====================================================
         DESKTOP
         ===================================================== -->

    <div class="bp-desktop-layout">

      <div class="bp-desktop-collage">

        {% for block in section.blocks %}

          <div
            class="bp-desktop-image"
            style="
              left: {{ block.settings.desktop_left }}px;
              top: {{ block.settings.desktop_top }}px;
              width: {{ block.settings.desktop_width }}px;
              height: {{ block.settings.desktop_height }}px;
              z-index: {{ forloop.index }};
              border-radius: {{ block.settings.desktop_image_radius }}px;
            "
            {{ block.shopify_attributes }}
          >

            {% if block.settings.image != blank %}

              {{
                block.settings.image
                | image_url: width: 1800
                | image_tag:
                  loading: 'lazy',
                  widths: '400, 600, 800, 1000, 1200, 1500, 1800',
                  sizes: '(min-width: 750px) 300px, 100vw',
                  alt: block.settings.image_alt
              }}

            {% else %}

              <div class="bp-placeholder">
                Add image {{ forloop.index }}
              </div>

            {% endif %}

          </div>

        {% endfor %}

      </div>

      <div class="bp-content">

        <div class="bp-content-inner">

          {% if section.settings.heading != blank %}
            <h2 class="bp-heading">
              {{ section.settings.heading }}
            </h2>
          {% endif %}

          {% if section.settings.script_text != blank %}
            <div class="bp-script">
              {{ section.settings.script_text }}
            </div>
          {% endif %}

          {% if section.settings.description != blank %}
            <div class="bp-description">
              {{ section.settings.description }}
            </div>
          {% endif %}

          {% if section.settings.button_text != blank %}
            <a
              href="{{ section.settings.button_link }}"
              class="bp-button"
            >
              {{ section.settings.button_text }}
            </a>
          {% endif %}

        </div>

      </div>

    </div>


    <!-- =====================================================
         MOBILE
         ===================================================== -->

    <div class="bp-mobile-gallery">

      {% for block in section.blocks %}

        <div
          class="bp-mobile-slide {% if forloop.first %}is-active{% endif %}"
          data-mobile-slide="{{ forloop.index0 }}"
        >

          <div class="bp-mobile-image">

            {% if block.settings.image != blank %}

              {{
                block.settings.image
                | image_url: width: 1600
                | image_tag:
                  loading: 'lazy',
                  widths: '400, 600, 800, 1000, 1200, 1600',
                  sizes: '100vw',
                  alt: block.settings.image_alt
              }}

            {% else %}

              <div class="bp-placeholder">
                Add image {{ forloop.index }}
              </div>

            {% endif %}

          </div>

        </div>

      {% endfor %}

    </div>


    {% if section.blocks.size > 1 %}

      <div class="bp-mobile-controls">

        <button
          type="button"
          class="bp-arrow bp-prev"
          aria-label="Previous image"
        >

          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            aria-hidden="true"
          >
            <path d="M15 18L9 12L15 6"></path>
          </svg>

        </button>


        <div class="bp-dots">

          {% for block in section.blocks %}

            <button
              type="button"
              class="bp-dot {% if forloop.first %}is-active{% endif %}"
              data-mobile-dot="{{ forloop.index0 }}"
              aria-label="View image {{ forloop.index }}"
            ></button>

          {% endfor %}

        </div>


        <button
          type="button"
          class="bp-arrow bp-next"
          aria-label="Next image"
        >

          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            aria-hidden="true"
          >
            <path d="M9 18L15 12L9 6"></path>
          </svg>

        </button>

      </div>

    {% endif %}


    <!-- =====================================================
         MOBILE CONTENT
         ===================================================== -->

    <div class="bp-mobile-content">

      <div class="bp-mobile-content-inner">

        {% if section.settings.heading != blank %}
          <h2 class="bp-heading">
            {{ section.settings.heading }}
          </h2>
        {% endif %}

        {% if section.settings.script_text != blank %}
          <div class="bp-script">
            {{ section.settings.script_text }}
          </div>
        {% endif %}

        {% if section.settings.description != blank %}
          <div class="bp-description">
            {{ section.settings.description }}
          </div>
        {% endif %}

        {% if section.settings.button_text != blank %}
          <a
            href="{{ section.settings.button_link }}"
            class="bp-button"
          >
            {{ section.settings.button_text }}
          </a>
        {% endif %}

      </div>

    </div>

  </div>

</section>


<script>
  (function() {

    function initBrandPromise(section) {

      if (!section) return;

      var slides = Array.from(
        section.querySelectorAll('.bp-mobile-slide')
      );

      var dots = Array.from(
        section.querySelectorAll('.bp-dot')
      );

      var prev = section.querySelector('.bp-prev');
      var next = section.querySelector('.bp-next');

      if (!slides.length) return;

      var current = 0;
      var startX = 0;
      var endX = 0;

      function isMobile() {
        return window.innerWidth <= 749;
      }

      function isCarousel() {
        return (
          section.getAttribute('data-mobile-layout') ===
          'carousel'
        );
      }

      function showSlide(index) {

        if (!slides.length) return;

        current =
          (index + slides.length) %
          slides.length;

        if (isCarousel()) {

          slides.forEach(function(slide, i) {

            slide.classList.toggle(
              'is-active',
              i === current
            );

          });

        } else {

          slides.forEach(function(slide) {

            slide.classList.add('is-active');

          });

        }

        dots.forEach(function(dot, i) {

          dot.classList.toggle(
            'is-active',
            i === current
          );

        });
      }

      if (prev) {

        prev.addEventListener(
          'click',
          function() {

            if (!isCarousel()) return;

            showSlide(current - 1);

          }
        );

      }

      if (next) {

        next.addEventListener(
          'click',
          function() {

            if (!isCarousel()) return;

            showSlide(current + 1);

          }
        );

      }

      dots.forEach(function(dot) {

        dot.addEventListener(
          'click',
          function() {

            if (!isCarousel()) return;

            var index =
              parseInt(
                dot.getAttribute(
                  'data-mobile-dot'
                ),
                10
              );

            showSlide(index);

          }
        );

      });


      section.addEventListener(
        'touchstart',
        function(event) {

          if (!isMobile()) return;
          if (!isCarousel()) return;

          startX =
            event.changedTouches[0].screenX;

        },
        { passive: true }
      );


      section.addEventListener(
        'touchend',
        function(event) {

          if (!isMobile()) return;
          if (!isCarousel()) return;

          endX =
            event.changedTouches[0].screenX;

          var difference =
            startX - endX;

          if (
            Math.abs(difference) < 45
          ) {
            return;
          }

          if (difference > 0) {

            showSlide(current + 1);

          } else {

            showSlide(current - 1);

          }

        },
        { passive: true }
      );


      showSlide(0);
    }


    function bootBrandPromise() {

      var section =
        document.getElementById(
          '{{ section_id }}'
        );

      if (section) {
        initBrandPromise(section);
      }

    }


    bootBrandPromise();


    document.addEventListener(
      'shopify:section:load',
      function(event) {

        if (
          event.detail &&
          event.detail.sectionId ===
            '{{ section.id }}'
        ) {

          var loadedSection =
            document.getElementById(
              '{{ section_id }}'
            );

          if (loadedSection) {
            initBrandPromise(
              loadedSection
            );
          }

        }

      }
    );

  })();
</script>


