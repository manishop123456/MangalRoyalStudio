<section id="mrs-wishlist-{{ section.id }}" class="mrs-wishlist-section">
  <div class="mrs-wishlist-container">
    <header class="mrs-wishlist-header">
      {% if section.settings.eyebrow != blank %}
        <p class="mrs-wishlist-eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}
      <h1 class="mrs-wishlist-title">{{ section.settings.heading }}</h1>
      <p class="mrs-wishlist-subtitle" data-wishlist-count-label>Loading your saved pieces...</p>
    </header>

    <div class="mrs-wishlist-grid" data-wishlist-grid></div>

    <div class="mrs-wishlist-empty" data-wishlist-empty hidden>
      <div class="mrs-wishlist-empty__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="44" height="44" fill="none" stroke="#7D132A" stroke-width="1.3">
          <path d="M12 20.6 4.3 13a4.7 4.7 0 0 1 0-6.7 4.7 4.7 0 0 1 6.7 0l1 1 1-1a4.7 4.7 0 0 1 6.7 0 4.7 4.7 0 0 1 0 6.7Z" stroke-linejoin="round"/>
        </svg>
      </div>
      <h2 class="mrs-wishlist-empty__heading">{{ section.settings.empty_heading }}</h2>
      <p class="mrs-wishlist-empty__text">{{ section.settings.empty_text }}</p>
      <a href="{{ routes.all_products_collection_url }}" class="mrs-wishlist-cta">
        {{ section.settings.cta_label }}
      </a>
    </div>
  </div>

  <style>
    @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=Great+Vibes&family=DM+Sans:wght@400;500;600&display=swap');

    #mrs-wishlist-{{ section.id }} {
      background: #FFFFFF;
      color: #190303;
      padding: 64px 40px 88px;
    }
    #mrs-wishlist-{{ section.id }} .mrs-wishlist-container {
      max-width: 1440px;
      margin: 0 auto;
    }
    #mrs-wishlist-{{ section.id }} .mrs-wishlist-header {
      text-align: center;
      margin-bottom: 48px;
    }
    #mrs-wishlist-{{ section.id }} .mrs-wishlist-eyebrow {
      font-family: 'Battlemade', 'Great Vibes', cursive;
      font-size: 48px;
      line-height: 1;
      color: #7D132A;
      margin: 0 0 6px;
    }
    #mrs-wishlist-{{ section.id }} .mrs-wishlist-title {
      font-family: 'Begum', 'Cormorant Garamond', Georgia, serif;
      font-size: 42px;
      font-weight: 400;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      color: #190303;
      margin: 0;
    }
    #mrs-wishlist-{{ section.id }} .mrs-wishlist-subtitle {
      font-family: 'Gotham', 'DM Sans', sans-serif;
      font-size: 13px;
      color: #6B5B5B;
      margin: 10px 0 0;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }
    #mrs-wishlist-{{ section.id }} .mrs-wishlist-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 36px;
    }
    #mrs-wishlist-{{ section.id }} .mrs-wish-card {
      display: flex;
      flex-direction: column;
      border: 1px solid #EEEEEE;
      background: #FFFFFF;
    }
    #mrs-wishlist-{{ section.id }} .mrs-wish-card__media {
      position: relative;
      display: block;
      aspect-ratio: 285 / 397;
      background: #F6F3F1;
      overflow: hidden;
    }
    #mrs-wishlist-{{ section.id }} .mrs-wish-card__media img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 0.6s ease;
    }
    #mrs-wishlist-{{ section.id }} .mrs-wish-card:hover .mrs-wish-card__media img {
      transform: scale(1.05);
    }
    #mrs-wishlist-{{ section.id }} .mrs-wish-card__remove {
      position: absolute;
      top: 10px;
      right: 10px;
      width: 32px;
      height: 32px;
      border-radius: 50%;
      border: 0;
      background: rgba(255, 255, 255, 0.92);
      color: #7D132A;
      cursor: pointer;
      display: grid;
      place-items: center;
      font-size: 16px;
    }
    #mrs-wishlist-{{ section.id }} .mrs-wish-card__body {
      padding: 18px 16px 16px;
      display: flex;
      flex-direction: column;
      gap: 12px;
      flex: 1;
    }
    #mrs-wishlist-{{ section.id }} .mrs-wish-card__title {
      font-family: 'Gotham', 'DM Sans', sans-serif;
      font-size: 14px;
      line-height: 18px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: #190303;
      text-decoration: none;
      min-height: 36px;
    }
    #mrs-wishlist-{{ section.id }} .mrs-wish-card__price {
      font-family: 'Gotham', 'DM Sans', sans-serif;
      font-size: 16px;
      letter-spacing: 0.1em;
      color: #7D132A;
      font-weight: 500;
    }
    #mrs-wishlist-{{ section.id }} .mrs-wish-card__btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      min-height: 34px;
      background: #7D132A;
      color: #FFFFFF;
      text-decoration: none;
      text-transform: uppercase;
      font-family: 'Gotham', 'DM Sans', sans-serif;
      font-size: 12px;
      letter-spacing: 0.1em;
      border: 0;
      cursor: pointer;
    }
    #mrs-wishlist-{{ section.id }} .mrs-wishlist-empty {
      max-width: 480px;
      margin: 24px auto;
      text-align: center;
      padding: 48px 24px;
      border: 1px solid #E7D1C4;
      background: #FBE8DB;
    }
    #mrs-wishlist-{{ section.id }} .mrs-wishlist-empty__heading {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: 28px;
      color: #190303;
      margin: 12px 0 8px;
    }
    #mrs-wishlist-{{ section.id }} .mrs-wishlist-empty__text {
      font-family: 'DM Sans', sans-serif;
      font-size: 13px;
      color: #5F5555;
      margin: 0 0 22px;
    }
    #mrs-wishlist-{{ section.id }} .mrs-wishlist-cta {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 40px;
      padding: 0 28px;
      background: #7D132A;
      color: #FFFFFF;
      text-decoration: none;
      text-transform: uppercase;
      font-family: 'DM Sans', sans-serif;
      font-size: 11px;
      letter-spacing: 0.12em;
    }
    @media screen and (max-width: 989px) {
      #mrs-wishlist-{{ section.id }} .mrs-wishlist-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 18px;
      }
      #mrs-wishlist-{{ section.id }} {
        padding: 40px 16px 60px;
      }
      #mrs-wishlist-{{ section.id }} .mrs-wishlist-eyebrow {
        font-size: 34px;
      }
      #mrs-wishlist-{{ section.id }} .mrs-wishlist-title {
        font-size: 28px;
      }
    }
  </style>

  <script>
    (function () {
      var root = document.getElementById('mrs-wishlist-{{ section.id }}');
      if (!root) return;
      var grid = root.querySelector('[data-wishlist-grid]');
      var emptyBox = root.querySelector('[data-wishlist-empty]');
      var countLabel = root.querySelector('[data-wishlist-count-label]');

      function readItems() {
        try {
          return JSON.parse(localStorage.getItem('mrs:wishlist_items') || '[]');
        } catch (e) {
          return [];
        }
      }

      function removeItem(id, handle) {
        try {
          var items = readItems().filter(function (it) {
            return String(it.id) !== String(id) && it.handle !== handle;
          });
          localStorage.setItem('mrs:wishlist_items', JSON.stringify(items));

          var ids = JSON.parse(localStorage.getItem('pc:wishlist') || '[]').filter(function (x) {
            return String(x) !== String(id);
          });
          localStorage.setItem('pc:wishlist', JSON.stringify(ids));

          var handles = JSON.parse(localStorage.getItem('mangal-wishlist') || '[]').filter(function (h) {
            return h !== handle;
          });
          localStorage.setItem('mangal-wishlist', JSON.stringify(handles));
        } catch (e) {}
        renderWishlist();
      }

      function renderWishlist() {
        var items = readItems();
        grid.innerHTML = '';

        if (!items.length) {
          grid.hidden = true;
          emptyBox.hidden = false;
          if (countLabel) countLabel.textContent = '0 Saved Items';
          return;
        }

        grid.hidden = false;
        emptyBox.hidden = true;
        if (countLabel) {
          countLabel.textContent = items.length + (items.length === 1 ? ' Saved Piece' : ' Saved Pieces');
        }

        items.forEach(function (item) {
          var card = document.createElement('article');
          card.className = 'mrs-wish-card';
          var url = item.url || ('/products/' + (item.handle || ''));
          card.innerHTML =
            '<a class="mrs-wish-card__media" href="' + url + '">' +
              (item.image ? '<img src="' + item.image + '" alt="' + (item.title || '') + '" loading="lazy">' : '') +
              '<button type="button" class="mrs-wish-card__remove" aria-label="Remove from wishlist" data-remove-wish>×</button>' +
            '</a>' +
            '<div class="mrs-wish-card__body">' +
              '<a class="mrs-wish-card__title" href="' + url + '">' + (item.title || item.handle || 'Jewellery Piece') + '</a>' +
              '<div class="mrs-wish-card__price">' + (item.priceFormatted || '') + '</div>' +
              '<a class="mrs-wish-card__btn" href="' + url + '">View Piece</a>' +
            '</div>';

          var removeBtn = card.querySelector('[data-remove-wish]');
          if (removeBtn) {
            removeBtn.addEventListener('click', function (ev) {
              ev.preventDefault();
              ev.stopPropagation();
              removeItem(item.id, item.handle);
            });
          }
          grid.appendChild(card);
        });
      }

      renderWishlist();
    })();
  </script>
</section>

{% schema %}
{
  "name": "MRS Wishlist Page",
  "tag": "section",
  "class": "mrs-wishlist-page-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow script",
      "default": "Curated by you"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "My Wishlist"
    },
    {
      "type": "text",
      "id": "empty_heading",
      "label": "Empty state heading",
      "default": "Your wishlist is currently empty"
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "Empty state text",
      "default": "Save your favourite certified lab-grown diamond jewellery pieces to revisit them anytime."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Explore button label",
      "default": "Explore Collections"
    }
  ],
  "presets": [
    {
      "name": "MRS Wishlist Page"
    }
  ]
}
{% endschema %}

